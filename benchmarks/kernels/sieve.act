"""Sieve of Eratosthenes below 1 000 000, three rounds: array indexing. Wrapping arithmetic, as in its C twin."""
verb count_primes() -> u64 {
    erg composite: Array[u8, 1000000] = Array[u8, 1000000]();
    erg count: u64 = 0;
    erg candidate: u64 = 2;
    loop {
        if candidate >= 1000000 {
            break;
        }
        if composite[candidate] == 0 {
            count = count +% 1;
            erg multiple = candidate *% candidate;
            loop {
                if multiple >= 1000000 {
                    break;
                }
                composite[multiple] = 1;
                multiple = multiple +% candidate;
            }
        }
        candidate = candidate +% 1;
    }
    return count;
}

verb main() -> Int {
    erg total: u64 = 0;
    erg round: u64 = 0;
    loop {
        if round >= 3 {
            break;
        }
        total = total +% count_primes();
        round = round +% 1;
    }
    return (total % 256) as Int;
}
