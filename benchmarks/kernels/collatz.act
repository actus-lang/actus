"""
Collatz steps for every start below 300 000: branchy u64 loops. Wrapping arithmetic, as in its C
twin.
"""
verb steps(erg start: u64) -> u64 {
    erg value = start;
    erg count: u64 = 0;
    loop {
        if value == 1 {
            break;
        }
        if value % 2 == 0 {
            value = value / 2;
        } else {
            value = value *% 3 +% 1;
        }
        count = count +% 1;
    }
    return count;
}

verb main() -> Int {
    erg total: u64 = 0;
    erg start: u64 = 1;
    loop {
        if start >= 300000 {
            break;
        }
        total = total +% steps(start: start);
        start = start +% 1;
    }
    return (total % 256) as Int;
}
