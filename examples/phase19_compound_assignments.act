"""
Gate 19.3.2 acceptance: typed arithmetic and every native compound assignment
operator across scalar, array, struct-field, and pack-field places.
"""
pack Register {
    erg storage: u8;
    layout little;
    fields {
        erg value: u8 at 0;
    }
}

struct Counter {
    erg value: u8,
}

verb main() -> Int {
    erg scalar: u8 = 5u8;
    scalar += 7u8;
    scalar -= 2u8;
    scalar *= 3u8;
    scalar /= 5u8;
    scalar %= 4u8;
    scalar &= 3u8;
    scalar |= 4u8;
    scalar ^= 1u8;
    scalar <<= 1u8;
    scalar >>= 1u8;
    erg values: Array[u8,1] = Array[u8, 1]();
    values[0u8] = 5u8;
    values[0u8] += 37u8;
    erg counter = Counter {value: 5u8};
    counter.value += 37u8;
    erg register = Register {storage: 5u8};
    register.value += 37u8;
    return scalar as Int + values[0u8] as Int + counter.value as Int + register.value as Int;
}
