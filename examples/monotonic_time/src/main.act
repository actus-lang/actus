"""
General monotonic timing example.

This example is intentionally independent of any application engine. It
captures an instant, constructs and converts a duration, checks a deadline,
and observes a typed overflow failure.
"""
import {
    open std::io,
    open std::time,
};

"""
Extract the duration from a result that the example expects to succeed. A
successful result yields its duration; an error yields a zero-nanosecond
duration so the example can continue and report the failure through its exit
status. The candidate is consumed, and the function allocates nothing and has no
side effects.
"""
verb unwrap_duration(erg candidate: Result[Duration, TimeError]) -> Duration {
    return case dat candidate {
        Result.Ok(value) => value,
        Result.Err(_) => Duration {
            nanos: 0u64,
        },
    };
}

"""
Extract the deadline from a result that the example expects to succeed. A
successful result yields its deadline; an error yields a deadline that expires
at tick zero so the example can continue and report the failure through its exit
status. The candidate is consumed, and the function allocates nothing and has no
side effects.
"""
verb unwrap_deadline(erg candidate: Result[Deadline, TimeError]) -> Deadline {
    return case dat candidate {
        Result.Ok(value) => value,
        Result.Err(_) => Deadline {
            expires_at: 0u64,
        },
    };
}

"""
contract:
purpose:
    Run the monotonic timing example: capture an instant, build a one
    millisecond duration, derive a deadline from it, check that the deadline
    has not expired and that a deadline past the largest instant overflows.
outputs:
    Exit status 0 when every check holds and 2 otherwise.
side_effects:
    Reads the monotonic clock and prints one summary line to standard output.
"""
meta effect("clock")
verb main() -> Int {
    erg started: Instant = now();
    erg one_millisecond: u64 = 1u64;
    erg duration_result = duration_milliseconds(milliseconds: erg one_millisecond);
    erg duration: Duration = unwrap_duration(candidate: erg duration_result);
    erg duration_nanos: u64 = duration_as_nanos(abs duration);
    erg deadline_result = deadline_after(start: abs started, duration: abs duration);
    erg deadline: Deadline = unwrap_deadline(candidate: erg deadline_result);
    erg expired_now: Bool = expired(deadline: abs deadline);
    erg maximum: Instant = Instant {
        ticks: 18446744073709551615u64,
    };
    erg overflow_result = deadline_after(start: abs maximum, duration: abs duration);
    erg overflowed: Bool = case dat overflow_result {
        Result.Ok(_) => false,
        Result.Err(_) => true,
    };
    erg summary = "monotonic time example passed";
    println(abs summary);
    if duration_nanos == 1000000u64 && !expired_now && overflowed {
        return 0;
    }
    return 2;
}
