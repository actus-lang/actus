struct Point {
    x: Int,
    y: Int,
}

struct Player {
    position: Point,
    score: Int,
}

"""
Return the sum of the player position coordinates and the score. The player is an immutable `abs`
view and is not modified.
"""
verb total_score(abs self: Player) -> Int {
    return self.position.x + self.position.y + self.score;
}

"""
Build a player, move it to x equal to 8, compute its total score through a borrowed view, print the
result and return it, 17.
"""
verb main() -> Int {
    erg player = Player {
        position: Point {
            x: 3,
            y: 4,
        },
        score: 5,
    };
    player.position.x = 8;
    abs player_view = ref player;
    erg result = player_view.total_score();
    print(int: result);
    return result;
}
