"""
`std::region` lifecycle example.

The element type is `Array[u16, 2]`, so every resident element occupies four
bytes. The logical region has four elements, while exactly one element is
resident at a time. All buffers are caller-owned and all lifecycle operations
return typed results.
"""
import std::region;

"""
contract:
purpose:
    Open the four-element example region with a one-element resident window
    over a four-byte backing buffer.
outputs:
    `Ok(region)` owning the backing buffer, or the `RegionError` of the open.
ownership:
    The backing buffer is consumed into the region.
side_effects:
    Allocates the backing buffer and the region metadata.
"""
meta effect("allocation")
verb open_example() -> Result[region::Region[Array[u16, 2]], region::RegionError] {
    erg backing: Buffer = Buffer[4];
    erg logical_length: u64 = 4u64;
    erg window_start: u64 = 0u64;
    erg window_count: u64 = 1u64;
    return region::region_open[Array[u16, 2]](
        backing: dat backing,
        logical_length: erg logical_length,
        window_start: erg window_start,
        window_count: erg window_count
    );
}

"""
contract:
purpose:
    Write one element into the resident window and publish it, so the region
    generation advances.
inputs:
    region: the open region, borrowed exclusively.
outputs:
    0 on success, 1 when the write failed or wrote a different count, and 2
    when publishing failed.
side_effects:
    Allocates a four-byte source buffer and mutates the region.
"""
verb publish_region(ins region: region::Region[Array[u16, 2]]) -> Int {
    erg source: Buffer = Buffer[4];
    erg write_start: u64 = 0u64;
    erg write_count: u64 = 1u64;
    erg written = region::region_write_range[Array[u16, 2]](
        region: ins region,
        start_index: erg write_start,
        element_count: erg write_count,
        source: abs source
    );
    return case dat written {
        Result.Err(_) => 1,
        Result.Ok(count) => {
            if count != 1u64 {
                return 1;
            }
            erg published = region::region_publish[Array[u16, 2]](region: ins region);
            return case dat published {
                Result.Ok(_) => 0,
                Result.Err(_) => 2,
            };
        },
    };
}

"""
contract:
purpose:
    Read the published element back into a caller buffer.
inputs:
    region: the open region, borrowed read-only.
outputs:
    0 when exactly one element was read, 3 for a different count and 4 when the
    read failed.
side_effects:
    Allocates a four-byte destination buffer; the region is not modified.
"""
verb read_published(abs region: region::Region[Array[u16, 2]]) -> Int {
    erg destination: Buffer = Buffer[4];
    erg read_start: u64 = 0u64;
    erg read_count: u64 = 1u64;
    erg read = region::region_read_range[Array[u16, 2]](
        region: abs region,
        start_index: erg read_start,
        element_count: erg read_count,
        destination: ins destination
    );
    return case dat read {
        Result.Err(_) => 4,
        Result.Ok(count) => {
            if count != 1u64 {
                return 3;
            }
            return 0;
        },
    };
}

"""
contract:
purpose:
    Write one element and cancel it, restoring the last published bytes.
inputs:
    region: the open region, borrowed exclusively.
outputs:
    0 when the cancel reported zero, 5 when the write failed and 6 when the
    cancel failed or reported another value.
side_effects:
    Allocates a four-byte source buffer and mutates the region, then rolls the
    resident bytes back.
"""
verb cancel_region(ins region: region::Region[Array[u16, 2]]) -> Int {
    erg source: Buffer = Buffer[4];
    erg index: u64 = 0u64;
    erg written = region::region_write[Array[u16, 2]](
        region: ins region,
        index: erg index,
        source: abs source
    );
    return case dat written {
        Result.Err(_) => 5,
        Result.Ok(_) => {
            erg canceled = region::region_cancel[Array[u16, 2]](region: ins region);
            return case dat canceled {
                Result.Ok(value) => if value == 0 {
                    0
                } else {
                    6
                },
                Result.Err(_) => 6,
            };
        },
    };
}

"""
contract:
purpose:
    Replace the clean resident window with a window that starts at element two.
inputs:
    region: the open region, borrowed exclusively.
outputs:
    0 on success and 7 when the remap failed.
ownership:
    The replacement backing buffer is consumed into the region.
side_effects:
    Allocates the replacement buffer and remaps the region.
"""
meta effect("allocation")
verb remap_region(ins region: region::Region[Array[u16, 2]]) -> Int {
    erg replacement: Buffer = Buffer[4];
    erg replacement_start: u64 = 2u64;
    erg replacement_count: u64 = 1u64;
    erg remapped = region::region_remap[Array[u16, 2]](
        region: ins region,
        backing: dat replacement,
        window_start: erg replacement_start,
        window_count: erg replacement_count
    );
    return case dat remapped {
        Result.Ok(_) => 0,
        Result.Err(_) => 7,
    };
}

"""
contract:
purpose:
    Run the region lifecycle example: open, publish, read, cancel, remap and
    close, stopping at the first step that fails.
outputs:
    Exit status 0 when every step succeeds. Otherwise the code of the failing
    step: 10 for open, 11 for close, or the code of the helper that failed.
side_effects:
    Allocates the region buffers and releases the region at the end.
"""
meta effect("allocation")
verb main() -> Int {
    erg opened = open_example();
    return case dat opened {
        Result.Err(_) => 10,
        Result.Ok(region) => {
            erg first = publish_region(region: ins region);
            if first != 0 {
                return first;
            }
            erg read = read_published(region: abs region);
            if read != 0 {
                return read;
            }
            erg second = cancel_region(region: ins region);
            if second != 0 {
                return second;
            }
            erg remapped = remap_region(region: ins region);
            if remapped != 0 {
                return remapped;
            }
            erg closed = region::region_close[Array[u16, 2]](region: ins region);
            return case dat closed {
                Result.Ok(_) => 0,
                Result.Err(_) => 11,
            };
        },
    };
}
