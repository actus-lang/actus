"""
Runtime profile demonstration.

The `std` build profile supplies the compiler-owned standard library. The
application imports the public `std::io` facade without a path dependency.
"""
import std::io;

verb main() -> Void {
    erg text = "text output";
    print(abs text);
    println(abs text);
    erg bytes = Buffer[0];
    append(bytes, 98);
    append(bytes, 121);
    append(bytes, 116);
    append(bytes, 101);
    append(bytes, 115);
    printb(abs bytes);
    printlnb(abs bytes);
}
