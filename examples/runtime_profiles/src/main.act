"""
Runtime profile demonstration.

The `std` build profile supplies the compiler-owned standard library. The
application imports the public `std::io` facade without a path dependency.
"""
import {
    open std::io,
};

"""
contract:
purpose:
    Show the `std` profile output verbs: print a string with and without a
    newline and print a byte buffer with and without a newline.
side_effects:
    Writes to standard output and allocates the five-byte buffer holding the
    text `bytes`.
"""
verb main() -> Void {
    erg text = "text output";
    print(string: abs text);
    println(abs text);
    erg bytes = Buffer[0];
    append(bytes, 98);
    append(bytes, 121);
    append(bytes, 116);
    append(bytes, 101);
    append(bytes, 115);
    printb(abs bytes);
    printlnb(abs bytes);
}
