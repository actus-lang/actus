// ADR-0042 Gate 7 systems-primitives demonstration.
// This example exercises native Buffer indexing, checked byte access,
// aggregate `ins` Array loans, read-only Array views, and checked u8 pack
// field mutation without an application-specific bridge.

pack ByteRegister {
    erg storage: u8;
    layout little;
    fields {
        erg payload: u8 at 0;
    }
}

verb inspect_buffer(abs bytes: Buffer) -> Int {
    erg first = bytes[0];
    erg last = bytes[1];
    return first + last;
}

verb mutate_array(ins values: Array[Int, 4]) {
    erg last_index = 3;
    values[1] = 40;
    values[last_index] = 2;
}

verb inspect_array(abs values: Array[Int, 4]) -> Int {
    erg observed_index = 1;
    return values[observed_index];
}

verb exercise_buffer_indexing() -> Int {
    erg bytes: Buffer = Buffer[0];
    append(bytes, 17);
    append(bytes, 25);
    return inspect_buffer(bytes: abs bytes);
}

verb exercise_array_loans() -> Int {
    erg values: Array[Int, 4] = Array[Int, 4]();
    mutate_array(values: ins values);
    erg observed = inspect_array(values: abs values);
    return observed + values[3];
}

verb exercise_checked_u8_pack_write() -> Int {
    erg register = ByteRegister { storage: 0, };
    erg input = 41;
    register.payload = input;
    return register.payload;
}

verb main() -> Int {
    erg buffer_total = exercise_buffer_indexing();
    erg array_total = exercise_array_loans();
    erg pack_total = exercise_checked_u8_pack_write();
    erg total = buffer_total + array_total + pack_total;
    print(total);
    return total;
}
