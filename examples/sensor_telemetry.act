"""A compact telemetry frame using Actus's width-qualified primitives."""
enum TelemetryError {
    InvalidMagic,
}

"""
Return the unit value. It exists so that validation and processing can report success through a
`Result` with a void payload.
"""
verb complete() -> Void {
    return;
}

"""
Accept a telemetry frame lent as an immutable `abs` view and report success. The example does not
inspect the bytes; it shows the signature of a validator that cannot modify or retain its input.
"""
verb validate_frame(abs frame: Buffer) -> Result[Void, String] {
    """The caller lends the frame as an abs view; validation allocates nothing."""
    return Result[Void, String].Ok(complete());
}

"""
Validate a frame and propagate a failure with `?`, otherwise report success. The frame is an
immutable `abs` view that is passed on to `validate_frame`.
"""
verb process_frame(abs frame: Buffer) -> Result[Void, String] {
    """`?` preserves the Result contract and unwinds the current scope on error."""
    validate_frame(frame: abs frame)?;
    return Result[Void, String].Ok(complete());
}

"""
Declare the width-qualified wire fields and floating point values of a telemetry packet, fill a
buffer with six sample bytes, process it and return 0 on success or 1 on failure as the exit status.
"""
verb main() -> Int {
    """Width-qualified wire fields."""
    erg sequence: u8 = 7;
    erg packet_length: u16 = 128;
    erg device_id: u32 = 0xDEADBEEF;
    erg timestamp: u64 = 1700000000;
    erg extended_counter: u128 = 255;
    erg signed_delta: i8 = -2;
    """IEEE-754 telemetry values."""
    erg temperature: f32 = 21.5;
    erg pressure: f64 = 1013.25;
    erg frame = Buffer[16];
    append(frame, 7);
    append(frame, 128);
    append(frame, 239);
    append(frame, 190);
    append(frame, 173);
    append(frame, 222);
    erg result = process_frame(frame: abs frame);
    return case dat result {
        Result.Ok(_) => 0,
        Result.Err(_) => 1,
    };
}
