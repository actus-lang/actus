struct Inner {
    erg first: Buffer,
    erg second: Buffer,
}

struct Outer {
    erg inner: Inner,
    erg tail: Buffer,
}

struct File {
    value: Int,
}

role Writer {
    verb write(abs self: File) -> Int;
}

perform Writer for File {
    """
    Implementation of the `Writer` role for `File`: return the file value plus one. The file is an immutable `abs` view and is not modified.
    """
    verb write(abs self: File) -> Int {
        return self.value + 1;
    }
}

enum Color {
    Red,
    Green,
}

enum Message {
    Data {code: Int},
    Empty,
}

"""
Take ownership of a buffer, drop it and return 0. It is used to move nested buffer fields out of a struct one at a time.
"""
verb consume(dat item: Buffer) -> Int {
    drop(item);
    return 0;
}

"""
Exercise static role dispatch, an enum match, nested struct field moves and an enum with a payload, and return 42 plus 1 plus the payload 1, 44, as the exit status.
"""
verb main() -> Int {
    erg file = File {
        value: 41,
    };
    abs file_view = ref file;
    erg static_score = file_view.write();
    erg color = Color.Red;
    erg inspected = case abs color {
        Color.Red => 1,
        _ => 0,
    };
    erg outer = Outer {
        inner: Inner {
            first: Buffer[1],
            second: Buffer[2],
        },
        tail: Buffer[3],
    };
    consume(item: outer.inner.first);
    consume(item: outer.inner.second);
    erg message = Message.Data(code: 1);
    return case dat message {
        Message.Data {code: value} => static_score + inspected + value,
        Message.Empty => 0,
    };
}
