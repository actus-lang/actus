"""
Phase 19.2 file utility.
It constructs a raw POSIX path, writes and reads a file, inspects metadata,
removes the file, and validates the typed missing-file failure afterward.
"""
import {
    open io,
    open path,
    open fs,
};

"""
contract:
purpose:
    Build the relative path `./actus_p192.bin` from raw ASCII bytes and
    normalize it.
outputs:
    `Ok(path)` with the normalized path, or the `PathError` of the path module.
ownership:
    The raw buffer is consumed by the path constructor; the result is a newly
    owned path.
side_effects:
    Allocates the raw byte buffer and the path.
"""
verb utility_path() -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append(raw, 46);
    append(raw, 47);
    append(raw, 97);
    append(raw, 99);
    append(raw, 116);
    append(raw, 117);
    append(raw, 115);
    append(raw, 95);
    append(raw, 112);
    append(raw, 49);
    append(raw, 57);
    append(raw, 50);
    append(raw, 46);
    append(raw, 98);
    append(raw, 105);
    append(raw, 110);
    append(raw, 0);
    erg parsed = path_from_ascii(storage: dat raw);
    return case dat parsed {
        Result.Err(error) => Result[Path, PathError].Err(error),
        Result.Ok(path) => normalize(dat path),
    };
}

"""
Check that a path is relative and has a final file name. The path is an immutable
`abs` view. The verb returns 0 when both hold, 20 when the path is not relative
and 22 when it has no file name. It performs no I/O.
"""
verb validate_path(abs path: Path) -> Int {
    case is_relative(self: abs path) {
        true => {},
        _ => {
            return 20;
        },
    };
    erg name = file_name(self: abs path);
    return case dat name {
        Option.Some(_) => 0,
        Option.None => 22,
    };
}

"""
contract:
purpose:
    Write the payload to the file, read it back, print it and continue with
    `inspect_and_remove`.
inputs:
    path: the file path; payload: the bytes to write.
outputs:
    The status of `inspect_and_remove` on success, 11 when the write failed and
    12 when the read failed.
side_effects:
    Blocking filesystem I/O: creates or replaces the file, reads it and writes
    its content to standard output.
"""
meta effect("filesystem", "blocking")
verb process_file(abs path: Path, abs payload: Buffer) -> Int {
    erg written = write_file(path: abs path, contents: abs payload);
    case dat written {
        Result.Err(_) => {
            return 11;
        },
        Result.Ok(_) => {},
    };
    erg loaded = read_to_bytes(path: abs path);
    case dat loaded {
        Result.Err(_) => {
            return 12;
        },
        Result.Ok(value) => {
            printb(text: abs value);
            flush();
            drop(value);
            return inspect_and_remove(path: abs path);
        },
    };
    return 12;
}

"""
contract:
purpose:
    Read the file metadata, remove the file and check that a later read fails
    with the typed `Failed` error.
inputs:
    path: the file to inspect and remove.
outputs:
    0 when the file was removed and the later read failed with `Failed`; 13
    when the metadata could not be read, 14 when the removal failed, 18 when
    the removed file could still be read, and 15 to 22 for another I/O error
    on the final read.
side_effects:
    Blocking filesystem I/O: reads metadata and removes the file.
"""
meta effect("filesystem", "blocking")
verb inspect_and_remove(abs path: Path) -> Int {
    erg information = metadata(path: abs path);
    case dat information {
        Result.Err(_) => {
            return 13;
        },
        Result.Ok(_) => {},
    };
    erg removed = remove_file(path: abs path);
    case dat removed {
        Result.Err(_) => {
            return 14;
        },
        Result.Ok(_) => {},
    };
    erg missing = read_to_bytes(path: abs path);
    return case dat missing {
        Result.Err(error) => case dat error {
            IoError.Failed => 0,
            IoError.EndOfStream => 15,
            IoError.InvalidInput => 16,
            IoError.InvalidData => 17,
            IoError.Unsupported => 18,
            IoError.PermissionDenied => 19,
            IoError.Busy => 20,
            IoError.CrossDevice => 21,
            IoError.AlreadyExists => 22,
        },
        Result.Ok(value) => {
            drop(value);
            return 18;
        },
    };
}

"""
contract:
purpose:
    Run the file utility: build the path, validate it, then write, read,
    inspect and remove the file.
outputs:
    0 on success; 10 when the path cannot be built; otherwise the status of the
    failing step of `validate_path` or `process_file`.
side_effects:
    Blocking filesystem I/O in the current directory and output to standard
    output.
"""
meta effect("filesystem", "blocking")
verb main() -> Int {
    erg path_result = utility_path();
    erg payload = Buffer[0];
    append(payload, 65);
    append(payload, 67);
    append(payload, 84);
    return case dat path_result {
        Result.Err(_) => 10,
        Result.Ok(path) => {
            erg valid = validate_path(path: abs path);
            return case valid {
                0 => process_file(path: abs path, payload: abs payload),
                _ => valid,
            };
        },
    };
}
