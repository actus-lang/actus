"""
Phase 19.2 console application.
It reads one line through std::io, echoes successful input to stdout,
reports EOF to stderr, and returns an application-level status.
"""
import {
    open io,
};

"""
contract:
purpose:
    Read one line from standard input, echo it and report failures as exit codes.
outputs:
    0 when a line was read; 2 at end of input; 3 to 10 for the other I/O
    errors in the order of the `IoError` variants after `EndOfStream`.
side_effects:
    Reads standard input, writes the line to standard output and to standard
    error, and flushes the output. At end of input it writes the two bytes `EO`
    to standard error.
"""
verb main() -> Int {
    erg input = Buffer[0];
    erg result = read_line(buffer: ins input);
    return case dat result {
        Result.Ok(_) => {
            printlnb(text: abs input);
            eprintln(buffer: abs input);
            flush();
            return 0;
        },
        Result.Err(error) => case dat error {
            IoError.EndOfStream => {
                erg message = Buffer[0];
                append(message, 69);
                append(message, 79);
                eprintln(buffer: abs message);
                return 2;
            },
            IoError.Failed => {
                return 3;
            },
            IoError.InvalidInput => {
                return 4;
            },
            IoError.InvalidData => {
                return 5;
            },
            IoError.Unsupported => {
                return 6;
            },
            IoError.PermissionDenied => {
                return 7;
            },
            IoError.Busy => {
                return 8;
            },
            IoError.CrossDevice => {
                return 9;
            },
            IoError.AlreadyExists => {
                return 10;
            },
        },
    };
}
