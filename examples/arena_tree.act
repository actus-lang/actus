"""
A recursive arena-backed binary tree. Each child is a pointer-sized
Option reference: None is null and Some(node) stores the node address.
"""
struct Node {
    value: Int,
    abs left: Option[abs Node],
    abs right: Option[abs Node],
}

"""
Recursively add the value of a tree node and of all its descendants. The node is an immutable `abs` view; each child is an optional reference, so a missing child contributes 0 and a present one is visited with the same borrowed access. Recursion depth equals the height of the tree.
"""
verb sum(abs node: Node) -> Int {
    abs left = ref node.left;
    abs right = ref node.right;
    return node.value + case left {
        Option.Some(child) => sum(node: abs child),
        Option.None => 0,
    } + case right {
        Option.Some(child) => sum(node: abs child),
        Option.None => 0,
    };
}

"""
Build a three-node tree in a 512-byte arena, with a root of 30 and children of 10 and 20, and return the sum of its values, 60. The arena owns the nodes and releases them when it goes out of scope.
"""
verb main() -> Int {
    erg arena: Arena[512] = Arena[512]();
    erg left = arena.place(value: Node {
        value: 10,
        left: Option[abs Node].None,
        right: Option[abs Node].None,
    });
    erg right = arena.place(value: Node {
        value: 20,
        left: Option[abs Node].None,
        right: Option[abs Node].None,
    });
    erg root = arena.place(value: Node {
        value: 30,
        left: Option[abs Node].Some(left),
        right: Option[abs Node].Some(right),
    });
    abs view = ref root;
    return sum(node: abs view);
}
