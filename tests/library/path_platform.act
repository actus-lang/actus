import path;

verb make_posix(dat raw: Buffer) -> Path {
    erg result = path_from_posix(storage: dat raw);
    return case dat result {
        Result.Ok(path) => path,
        Result.Err(_) => Path {
            storage: Buffer[1],
            platform: PathPlatform.Posix,
            length: 0,
            capacity: 1,
            terminated: 1,
        },
    };
}

verb make_windows(dat raw: Buffer) -> Path {
    erg result = path_from_windows_utf16(storage: dat raw);
    return case dat result {
        Result.Ok(path) => path,
        Result.Err(_) => Path {
            storage: Buffer[2],
            platform: PathPlatform.Windows,
            length: 0,
            capacity: 2,
            terminated: 1,
        },
    };
}

meta target("unix")
verb posix_bin_path() -> Path {
    erg raw = Buffer[0];
    append(raw, 47);
    append(raw, 117);
    append(raw, 115);
    append(raw, 114);
    append(raw, 47);
    append(raw, 98);
    append(raw, 105);
    append(raw, 110);
    append(raw, 0);
    return make_posix(raw: dat raw);
}

verb posix_usr_path() -> Path {
    erg raw = Buffer[0];
    append(raw, 47);
    append(raw, 117);
    append(raw, 115);
    append(raw, 114);
    append(raw, 0);
    return make_posix(raw: dat raw);
}

verb posix_us_path() -> Path {
    erg raw = Buffer[0];
    append(raw, 47);
    append(raw, 117);
    append(raw, 115);
    append(raw, 0);
    return make_posix(raw: dat raw);
}

meta target("unix")
meta test
verb component_predicates_respect_boundaries() -> Int {
    erg path = posix_bin_path();
    erg prefix = posix_usr_path();
    erg partial = posix_us_path();
    case starts_with(self: abs path, prefix: abs prefix) {
        true => { },
        _ => { return 1; },
    };
    case starts_with(self: abs path, prefix: abs partial) {
        false => { },
        _ => { return 1; },
    };
    case ends_with(self: abs path, suffix: abs prefix) {
        false => { },
        _ => { return 1; },
    };
    return case ends_with(self: abs path, suffix: abs partial) {
        false => 0,
        _ => 1,
    };
}

verb drive_relative_path() -> Path {
    erg raw = Buffer[0];
    append(raw, 67);
    append(raw, 0);
    append(raw, 58);
    append(raw, 0);
    append(raw, 102);
    append(raw, 0);
    append(raw, 111);
    append(raw, 0);
    append(raw, 111);
    append(raw, 0);
    append(raw, 0);
    append(raw, 0);
    return make_windows(raw: dat raw);
}

verb mixed_separator_path() -> Path {
    erg raw = Buffer[0];
    append(raw, 67);
    append(raw, 0);
    append(raw, 58);
    append(raw, 0);
    append(raw, 92);
    append(raw, 0);
    append(raw, 97);
    append(raw, 0);
    append(raw, 47);
    append(raw, 0);
    append(raw, 98);
    append(raw, 0);
    append(raw, 0);
    append(raw, 0);
    return make_windows(raw: dat raw);
}

meta target("windows")
meta test
verb windows_drive_forms_and_mixed_separators() -> Int {
    erg relative = drive_relative_path();
    erg relative_kind = windows_root(abs relative);
    case dat relative_kind {
        Result.Ok(kind) => case dat kind {
            WindowsRoot.DriveRelative => { },
            _ => { return 1; },
        },
        Result.Err(_) => { return 1; },
    };
    case is_absolute(self: abs relative) {
        false => { },
        _ => { return 1; },
    };
    erg mixed = mixed_separator_path();
    case is_absolute(self: abs mixed) {
        true => { },
        _ => { return 1; },
    };
    erg name = file_name(self: abs mixed);
    return case dat name {
        Option.Some(component) => case component.length {
            1 => 0,
            _ => 1,
        },
        Option.None => 1,
    };
}

verb unc_path() -> Path {
    erg raw = Buffer[0];
    append(raw, 92);
    append(raw, 0);
    append(raw, 92);
    append(raw, 0);
    append(raw, 115);
    append(raw, 0);
    append(raw, 104);
    append(raw, 0);
    append(raw, 97);
    append(raw, 0);
    append(raw, 114);
    append(raw, 0);
    append(raw, 101);
    append(raw, 0);
    append(raw, 0);
    append(raw, 0);
    return make_windows(raw: dat raw);
}

verb windows_absolute_prefix() -> Buffer {
    erg raw = Buffer[0];
    append(raw, 67);
    append(raw, 0);
    append(raw, 58);
    append(raw, 0);
    append(raw, 92);
    append(raw, 0);
    return raw;
}

verb normalized_windows_path() -> Path {
    erg raw = windows_absolute_prefix();
    append(raw, 97);
    append(raw, 0);
    append(raw, 92);
    append(raw, 0);
    append(raw, 46);
    append(raw, 0);
    append(raw, 92);
    append(raw, 0);
    append(raw, 98);
    append(raw, 0);
    append(raw, 92);
    append(raw, 0);
    append(raw, 46);
    append(raw, 0);
    append(raw, 46);
    append(raw, 0);
    append(raw, 92);
    append(raw, 0);
    append(raw, 99);
    append(raw, 0);
    append(raw, 0);
    append(raw, 0);
    return make_windows(raw: dat raw);
}

meta target("windows")
meta test
verb windows_unc_and_normalization_preserve_units() -> Int {
    erg unc = unc_path();
    erg kind = windows_root(abs unc);
    case dat kind {
        Result.Ok(root) => case dat root {
            WindowsRoot.Unc => { },
            _ => { return 1; },
        },
        Result.Err(_) => { return 1; },
    };
    erg candidate = normalized_windows_path();
    erg normalized = normalize(dat candidate);
    return case dat normalized {
        Result.Ok(path) => case path.length {
            6 => 0,
            _ => 1,
        },
        Result.Err(_) => 1,
    };
}

meta test
verb invalid_utf16_and_non_utf8_posix_are_distinct() -> Int {
    erg invalid_raw = Buffer[0];
    append(invalid_raw, 255);
    append(invalid_raw, 216);
    append(invalid_raw, 0);
    append(invalid_raw, 0);
    erg invalid = path_from_windows_utf16(storage: dat invalid_raw);
    case dat invalid {
        Result.Ok(_) => { return 1; },
        Result.Err(error) => case dat error {
            PathError.InvalidEncoding => { },
            _ => { return 1; },
        },
    };
    erg raw = Buffer[0];
    append(raw, 255);
    append(raw, 0);
    erg valid = path_from_posix(storage: dat raw);
    return case dat valid {
        Result.Ok(path) => case path.length {
            1 => 0,
            _ => 1,
        },
        Result.Err(_) => 1,
    };
}
