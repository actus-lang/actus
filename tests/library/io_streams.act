import io;

meta test
verb copy_transfers_cursor_streams() -> Int {
    erg input_bytes = Buffer[0];
    append(input_bytes, 65);
    append(input_bytes, 66);
    erg reader: Cursor = Cursor { buffer: input_bytes, position: 0, };
    erg output_bytes = Buffer[0];
    erg writer: Cursor = Cursor { buffer: output_bytes, position: 0, };
    erg result = copy_stream(reader: ins reader, writer: ins writer);
    case dat result {
        Result.Ok(_) => { },
        Result.Err(_) => { return 1; },
    };
    erg offset = 0;
    writer.seek(offset: offset);
    erg copied = Buffer[0];
    erg read_back = writer.read(buffer: ins copied);
    return case dat read_back {
        Result.Ok(count) => case count {
            2 => 0,
            _ => 1,
        },
        Result.Err(_) => 1,
    };
}

meta test
verb buffered_reader_refills_cursor_storage() -> Int {
    erg input_bytes = Buffer[0];
    append(input_bytes, 65);
    erg source = cursor(dat input_bytes);
    erg storage = Buffer[1];
    erg reader = buffered_reader(dat source, dat storage);
    erg result = refill(reader: ins reader);
    return case dat result {
        Result.Ok(count) => case count {
            1 => 0,
            _ => 1,
        },
        Result.Err(_) => 1,
    };
}

meta test
verb buffered_writer_flushes_cursor_storage() -> Int {
    erg output_bytes = Buffer[0];
    erg target = cursor(dat output_bytes);
    erg storage = Buffer[0];
    erg storage_capacity = 2;
    erg reserved = reserve(buffer: ins storage, capacity: storage_capacity);
    case dat reserved {
        Result.Ok(_) => { },
        Result.Err(_) => { return 1; },
    };
    erg writer = buffered_writer(dat target, dat storage);
    erg input = Buffer[0];
    append(input, 65);
    append(input, 66);
    erg written = buffered_write(writer: ins writer, input: abs input);
    case dat written {
        Result.Ok(count) => case count {
            2 => { },
            _ => { return 1; },
        },
        Result.Err(_) => { return 1; },
    };
    erg flushed = flush_buffer(writer: ins writer);
    return case dat flushed {
        Result.Ok(_) => 0,
        Result.Err(_) => 1,
    };
}

verb append_one_byte(ins storage: Buffer, abs source: Buffer) -> Int {
    erg offset = 0;
    erg append_length = 1;
    erg appended = buffer_append_range(
        target: ins storage,
        source: abs source,
        offset: offset,
        length: append_length
    );
    return case dat appended {
        Result.Ok(count) => case count {
            1 => 0,
            _ => 1,
        },
        Result.Err(_) => 1,
    };
}

verb buffer_has_one_byte(abs storage: Buffer) -> Int {
    erg measured = buffer_size(buffer: abs storage);
    return case dat measured {
        Result.Ok(length) => case length {
            1 => 0,
            _ => 1,
        },
        Result.Err(_) => 1,
    };
}

verb clear_one_byte(ins storage: Buffer) -> Int {
    erg cleared = buffer_clear(buffer: ins storage);
    return case dat cleared {
        Result.Ok(count) => case count {
            1 => 0,
            _ => 1,
        },
        Result.Err(_) => 1,
    };
}

verb append_and_clear_buffer(ins storage: Buffer, abs source: Buffer) -> Int {
    erg appended = append_one_byte(storage: ins storage, source: abs source);
    case appended { 0 => { }, _ => { return 1; }, };
    erg valid_length = buffer_has_one_byte(storage: abs storage);
    case valid_length { 0 => { }, _ => { return 1; }, };
    return clear_one_byte(storage: ins storage);
}

meta test
verb buffer_utilities_preserve_reusable_storage() -> Int {
    erg storage = Buffer[0];
    erg capacity = 4;
    erg reserved = reserve(buffer: ins storage, capacity: capacity);
    case dat reserved {
        Result.Ok(_) => { },
        Result.Err(_) => { return 1; },
    };
    erg source = Buffer[0];
    append(source, 65);
    erg status = append_and_clear_buffer(storage: ins storage, source: abs source);
    return case status {
        0 => 0,
        _ => 1,
    };
}

meta test
verb stdin_eof_is_typed() -> Int {
    erg result = read_byte();
    return case dat result {
        Result.Ok(_) => 1,
        Result.Err(error) => case dat error {
            IoError.EndOfStream => 0,
            _ => 1,
        },
    };
}

verb emit_standard_output(abs text: Buffer) -> Int {
    erg value = 0;
    erg integer = print_int(value: value);
    erg printed = printb(text: abs text);
    erg line = printlnb(text: abs text);
    case dat integer {
        Result.Ok(_) => { },
        Result.Err(_) => { return 1; },
    };
    case dat printed {
        Result.Ok(_) => { },
        Result.Err(_) => { return 1; },
    };
    return case dat line {
        Result.Ok(_) => 0,
        Result.Err(_) => 1,
    };
}

verb emit_error_output(abs text: Buffer) -> Int {
    erg value = 0;
    erg integer = eprint_int(value: value);
    erg printed = eprint(text: abs text);
    erg line = eprintln(text: abs text);
    case dat integer {
        Result.Ok(_) => { },
        Result.Err(_) => { return 1; },
    };
    case dat printed {
        Result.Ok(_) => { },
        Result.Err(_) => { return 1; },
    };
    return case dat line {
        Result.Ok(_) => 0,
        Result.Err(_) => 1,
    };
}

verb emit_buffer_output(abs text: Buffer) -> Int {
    erg written = write(buffer: abs text);
    erg flushed = flush();
    case dat written {
        Result.Ok(_) => { },
        Result.Err(_) => { return 1; },
    };
    return case dat flushed {
        Result.Ok(_) => 0,
        Result.Err(_) => 1,
    };
}

meta test
verb output_wrappers_return_typed_status() -> Int {
    erg text = Buffer[0];
    erg standard = emit_standard_output(text: abs text);
    case standard {
        0 => { },
        _ => { return 1; },
    };
    erg error = emit_error_output(text: abs text);
    case error {
        0 => { },
        _ => { return 1; },
    };
    return emit_buffer_output(text: abs text);
}
