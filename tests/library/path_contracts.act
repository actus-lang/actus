import path;

verb make_posix(dat raw: Buffer) -> Path {
    erg result = path_from_posix(storage: dat raw);
    return case dat result {
        Result.Ok(path) => path,
        Result.Err(_) => Path {
            storage: Buffer[1],
            platform: PathPlatform.Posix,
            length: 0,
            capacity: 1,
            terminated: 1,
        },
    };
}

meta test
verb path_components_and_predicates() -> Int {
    erg raw = Buffer[0];
    append(raw, 47);
    append(raw, 117);
    append(raw, 115);
    append(raw, 114);
    append(raw, 47);
    append(raw, 97);
    append(raw, 114);
    append(raw, 99);
    append(raw, 104);
    append(raw, 105);
    append(raw, 118);
    append(raw, 101);
    append(raw, 46);
    append(raw, 116);
    append(raw, 97);
    append(raw, 114);
    append(raw, 46);
    append(raw, 103);
    append(raw, 122);
    append(raw, 0);
    erg path = make_posix(raw: dat raw);
    case is_absolute(self: abs path) {
        true => { },
        _ => { return 1; },
    };
    case is_relative(self: abs path) {
        false => { },
        _ => { return 1; },
    };
    case has_root(self: abs path) {
        true => { },
        _ => { return 1; },
    };
    erg name = file_name(self: abs path);
    erg stem = file_stem(self: abs path);
    erg extension = extension(self: abs path);
    case dat name {
        Option.Some(component) => case component.length {
            14 => { },
            _ => { return 1; },
        },
        Option.None => { return 1; },
    };
    case dat stem {
        Option.Some(component) => case component.length {
            11 => { },
            _ => { return 1; },
        },
        Option.None => { return 1; },
    };
    return case dat extension {
        Option.Some(component) => case component.length {
            2 => 0,
            _ => 1,
        },
        Option.None => 1,
    };
}

meta test
verb path_iteration_and_normalization() -> Int {
    erg raw = Buffer[0];
    append(raw, 97);
    append(raw, 47);
    append(raw, 46);
    append(raw, 47);
    append(raw, 98);
    append(raw, 47);
    append(raw, 46);
    append(raw, 46);
    append(raw, 47);
    append(raw, 99);
    append(raw, 0);
    erg raw_path = make_posix(raw: dat raw);
    erg normalized_result = normalize(dat raw_path);
    return case dat normalized_result {
        Result.Err(_) => 1,
        Result.Ok(normalized) => {
            erg iter = components(self: abs normalized);
            erg first = next_component(iter: ins iter);
            erg second = next_component(iter: ins iter);
            case dat first {
                Option.Some(component) => case component.length {
                    1 => { },
                    _ => { return 1; },
                },
                Option.None => { return 1; },
            };
            return case dat second {
                Option.Some(component) => case component.length {
                    1 => 0,
                    _ => 1,
                },
                Option.None => 1,
            };
        },
    };
}

meta test
verb path_builders_and_platform_parsers() -> Int {
    erg base_raw = Buffer[0];
    append(base_raw, 97);
    append(base_raw, 47);
    append(base_raw, 98);
    append(base_raw, 0);
    erg child_raw = Buffer[0];
    append(child_raw, 99);
    append(child_raw, 0);
    erg base = make_posix(raw: dat base_raw);
    erg child = make_posix(raw: dat child_raw);
    erg joined_result = join(self: dat base, other: abs child);
    return case dat joined_result {
        Result.Err(_) => 1,
        Result.Ok(joined) => {
            erg capacity = 16;
            erg reserved = reserve_path(self: ins joined, capacity: erg capacity);
            case dat reserved {
                Result.Ok(_) => { },
                Result.Err(_) => { return 1; },
            };
            erg pushed = push(self: ins joined, other: abs child);
            case dat pushed {
                Result.Ok(_) => { },
                Result.Err(_) => { return 1; },
            };
            erg slash = 47;
            case posix_is_separator(byte: erg slash) {
                1 => { },
                _ => { return 1; },
            };
            erg backslash = 92;
            case posix_is_separator(byte: erg backslash) {
                0 => 0,
                _ => 1,
            };
        },
    };
}

meta test
verb path_rejects_embedded_null_and_accepts_empty() -> Int {
    erg invalid = Buffer[0];
    append(invalid, 97);
    append(invalid, 0);
    append(invalid, 98);
    append(invalid, 0);
    erg invalid_result = path_from_posix(storage: dat invalid);
    case dat invalid_result {
        Result.Ok(_) => { return 1; },
        Result.Err(error) => case dat error {
            PathError.EmbeddedNull => { },
            _ => { return 1; },
        },
    };
    erg empty = Buffer[0];
    append(empty, 0);
    erg empty_result = path_from_posix(storage: dat empty);
    return case dat empty_result {
        Result.Ok(_) => 0,
        Result.Err(_) => 1,
    };
}
