"""Minimal hosted directory enumeration contract tests."""
import {
    open fs,
    open path,
};

verb current_directory() -> Result[Path, PathError] {
    erg raw: Buffer = Buffer[0];
    append(raw, 46u8);
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb close_directory_entry(ins directory: Directory, dat value: Option[Path]) -> Int {
    erg entry_code = case dat value {
        Option.None => 5,
        Option.Some(name) => case name.length {
            0 => 6,
            _ => 0,
        },
    };
    erg closed = close_dir(directory: ins directory);
    return case dat closed {
        Result.Err(_) => 4,
        Result.Ok(_) => entry_code,
    };
}

meta test
verb directory_iteration_returns_entry_and_closes() -> Int {
    erg current = current_directory();
    return case dat current {
        Result.Err(_) => 1,
        Result.Ok(path) => {
            erg opened = read_dir(path: abs path);
            return case dat opened {
                Result.Err(_) => 2,
                Result.Ok(directory) => {
                    erg entry = next_dir_entry(directory: ins directory);
                    return case dat entry {
                        Result.Err(_) => 3,
                        Result.Ok(value) => close_directory_entry(directory: ins directory, value: dat value),
                    };
                },
            };
        },
    };
}

verb missing_directory_path() -> Result[Path, PathError] {
    erg raw: Buffer = Buffer[0];
    append(raw, 47u8);
    append(raw, 120u8);
    append(raw, 121u8);
    append(raw, 0u8);
    return path_from_posix(storage: dat raw);
}

meta test
verb directory_iteration_rejects_missing_directory() -> Int {
    erg path = missing_directory_path();
    return case dat path {
        Result.Err(_) => 1,
        Result.Ok(value) => {
            erg opened = read_dir(path: abs value);
            return case dat opened {
                Result.Err(_) => 0,
                Result.Ok(directory) => {
                    close_dir(directory: ins directory);
                    2;
                },
            };
        },
    };
}

verb verify_repeated_eof(ins directory: Directory) -> Int {
    erg repeated = next_dir_entry(directory: ins directory);
    return case dat repeated {
        Result.Err(_) => {
            close_dir(directory: ins directory);
            1;
        },
        Result.Ok(second) => case dat second {
            Option.None => {
                erg closed = close_dir(directory: ins directory);
                return case dat closed {
                    Result.Ok(_) => 0,
                    Result.Err(_) => 2,
                };
            },
            Option.Some(name) => {
                drop(name);
                close_dir(directory: ins directory);
                3;
            },
        },
    };
}

meta test
verb repeated_directory_eof_remains_clean() -> Int {
    erg current = current_directory();
    return case dat current {
        Result.Err(_) => 1,
        Result.Ok(path) => {
            erg opened = read_dir(path: abs path);
            return case dat opened {
                Result.Err(_) => 2,
                Result.Ok(directory) => {
                    for erg attempt: u32 in 0u32 .. 4096u32 {
                        erg entry = next_dir_entry(directory: ins directory);
                        case dat entry {
                            Result.Err(_) => {
                                close_dir(directory: ins directory);
                                return 3;
                            },
                            Result.Ok(value) => case dat value {
                                Option.Some(name) => {
                                    drop(name);
                                },
                                Option.None => {
                                    return verify_repeated_eof(directory: ins directory);
                                },
                            },
                        };
                    }
                    close_dir(directory: ins directory);
                    7;
                },
            };
        },
    };
}

meta test
verb closed_directory_rejects_reuse() -> Int {
    erg current = current_directory();
    return case dat current {
        Result.Err(_) => 1,
        Result.Ok(path) => {
            erg opened = read_dir(path: abs path);
            return case dat opened {
                Result.Err(_) => 2,
                Result.Ok(directory) => {
                    erg closed = close_dir(directory: ins directory);
                    return case dat closed {
                        Result.Err(_) => 3,
                        Result.Ok(_) => {
                            erg next = next_dir_entry(directory: ins directory);
                            case dat next {
                                Result.Ok(value) => {
                                    case dat value {
                                        Option.Some(name) => {
                                            drop(name);
                                        },
                                        Option.None => {},
                                    };
                                    return 4;
                                },
                                Result.Err(_) => {},
                            };
                            erg closed_again = close_dir(directory: ins directory);
                            return case dat closed_again {
                                Result.Err(_) => 0,
                                Result.Ok(_) => 5,
                            };
                        },
                    };
                },
            };
        },
    };
}
