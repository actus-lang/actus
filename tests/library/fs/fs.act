"""Canonical facade coverage for qualified hosted filesystem access."""
import {
    std::fs,
    std::path,
};

verb current_directory() -> Result[path::Path, path::PathError] {
    erg raw: Buffer = Buffer[0];
    append(raw, 46u8);
    append(raw, 0u8);
    return path::path_from_ascii(storage: dat raw);
}

verb missing_metadata_path() -> Result[path::Path, path::PathError] {
    erg raw: Buffer = Buffer[0];
    append(raw, 47u8);
    append(raw, 97u8);
    append(raw, 99u8);
    append(raw, 116u8);
    append(raw, 117u8);
    append(raw, 115u8);
    append(raw, 45u8);
    append(raw, 109u8);
    append(raw, 105u8);
    append(raw, 115u8);
    append(raw, 115u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 103u8);
    append(raw, 45u8);
    append(raw, 109u8);
    append(raw, 101u8);
    append(raw, 116u8);
    append(raw, 97u8);
    append(raw, 100u8);
    append(raw, 97u8);
    append(raw, 116u8);
    append(raw, 97u8);
    append(raw, 0u8);
    return path::path_from_ascii(storage: dat raw);
}

meta test
verb qualified_filesystem_facade_opens_and_closes_directory() -> Int {
    erg current = current_directory();
    return case dat current {
        Result.Err(_) => 1,
        Result.Ok(path) => {
            erg opened = fs::read_dir(path: abs path);
            return case dat opened {
                Result.Err(_) => 2,
                Result.Ok(directory) => {
                    erg entry = fs::next_dir_entry(directory: ins directory);
                    erg entry_code = case dat entry {
                        Result.Err(_) => 3,
                        Result.Ok(value) => {
                            drop(value);
                            0;
                        },
                    };
                    erg closed = fs::close_dir(directory: ins directory);
                    return case dat closed {
                        Result.Err(_) => 4,
                        Result.Ok(_) => entry_code,
                    };
                },
            };
        },
    };
}

meta test
verb qualified_filesystem_facade_reports_directory_metadata() -> Int {
    erg current = current_directory();
    return case dat current {
        Result.Err(_) => 1,
        Result.Ok(path) => {
            erg inspected = fs::metadata(path: abs path);
            return case dat inspected {
                Result.Err(_) => 2,
                Result.Ok(metadata) => {
                    if metadata.is_dir == 1 {
                        if metadata.modified_status == METADATA_VALUE_AVAILABLE &&
                            metadata.identity_status == METADATA_VALUE_AVAILABLE &&
                            metadata.identity_kind != METADATA_IDENTITY_NONE {
                            return 0;
                        }
                    }
                    return 3;
                },
            };
        },
    };
}

meta test
verb qualified_filesystem_facade_distinguishes_missing_metadata() -> Int {
    erg path = missing_metadata_path();
    return case dat path {
        Result.Err(_) => 1,
        Result.Ok(value) => {
            erg inspected = fs::metadata_detailed(path: abs value);
            erg result: Int = 2;
            case dat inspected {
                Result.Err(error) => {
                    case error {
                        MetadataError.NotFound => {
                            result = 0;
                        },
                        _ => {},
                    };
                },
                Result.Ok(metadata) => {
                    drop(metadata);
                    result = 3;
                },
            };
            result;
        },
    };
}
