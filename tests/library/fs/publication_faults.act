"""Mirrored strict coverage for additional atomic-publication fault phases."""
import {
    fs,
    path,
};

verb publication_fault_path(erg suffix: u8) -> Result[path::Path, path::PathError] {
    erg raw: Buffer = Buffer[0];
    append(raw, 97u8);
    append(raw, 99u8);
    append(raw, 116u8);
    append(raw, 117u8);
    append(raw, 115u8);
    append(raw, 45u8);
    append(raw, 102u8);
    append(raw, 97u8);
    append(raw, 117u8);
    append(raw, 108u8);
    append(raw, 116u8);
    append(raw, 45u8);
    append(raw, suffix);
    append(raw, 0u8);
    return path::path_from_ascii(storage: dat raw);
}

verb verify_failed_publication(
    abs destination: path::Path,
    abs staging: path::Path
) -> Int {
    erg active = fs::read_to_bytes(path: abs destination);
    erg leftover = fs::read_to_bytes(path: abs staging);
    erg staging_exists: Bool = false;
    case dat leftover {
        Result.Ok(bytes) => {
            staging_exists = true;
            drop(bytes);
        },
        Result.Err(_) => {},
    };
    return case dat active {
        Result.Ok(bytes) => {
            drop(bytes);
            5;
        },
        Result.Err(_) => {
            if staging_exists {
                return 6;
            }
            0;
        },
    };
}

verb injected_prepublication_failure(erg destination_suffix: u8, erg staging_suffix: u8) -> Int {
    erg destination_result = publication_fault_path(suffix: erg destination_suffix);
    return case dat destination_result {
        Result.Err(_) => 1,
        Result.Ok(destination) => {
            erg staging_result = publication_fault_path(suffix: erg staging_suffix);
            return case dat staging_result {
                Result.Err(_) => 2,
                Result.Ok(staging) => {
                    erg staging_check_result = publication_fault_path(suffix: erg staging_suffix);
                    return case dat staging_check_result {
                        Result.Err(_) => 3,
                        Result.Ok(staging_check) => {
                            fs::remove_file(path: abs destination);
                            fs::remove_file(path: abs staging);
                            erg payload = Buffer[0];
                            append(payload, 70u8);
                            erg published = fs::write_file_atomic(
                                path: abs destination,
                                staging: dat staging,
                                contents: abs payload
                            );
                            return case dat published {
                                Result.Ok(_) => {
                                    fs::remove_file(path: abs destination);
                                    drop(staging_check);
                                    4;
                                },
                                Result.Err(_) => {
                                    erg result = verify_failed_publication(
                                        destination: abs destination,
                                        staging: abs staging_check
                                    );
                                    drop(staging_check);
                                    result;
                                },
                            };
                        },
                    };
                },
            };
        },
    };
}

meta target("unix")
meta fault("staging_open_failure")
meta test
verb injected_staging_open_failure_is_rejected() -> Int {
    erg destination_suffix: u8 = 75u8;
    erg staging_suffix: u8 = 76u8;
    return injected_prepublication_failure(
        destination_suffix: erg destination_suffix,
        staging_suffix: erg staging_suffix
    );
}

meta target("unix")
meta fault("write_failure")
meta test
verb injected_write_failure_is_rejected() -> Int {
    erg destination_suffix: u8 = 77u8;
    erg staging_suffix: u8 = 78u8;
    return injected_prepublication_failure(
        destination_suffix: erg destination_suffix,
        staging_suffix: erg staging_suffix
    );
}

meta target("unix")
meta fault("close_failure")
meta test
verb injected_close_failure_is_rejected() -> Int {
    erg destination_suffix: u8 = 79u8;
    erg staging_suffix: u8 = 80u8;
    return injected_prepublication_failure(
        destination_suffix: erg destination_suffix,
        staging_suffix: erg staging_suffix
    );
}

verb verify_cleanup_failure(
    abs destination: path::Path,
    abs staging: path::Path
) -> Int {
    erg active = fs::read_to_bytes(path: abs destination);
    return case dat active {
        Result.Ok(bytes) => {
            drop(bytes);
            1;
        },
        Result.Err(_) => {
            erg leftover = fs::read_to_bytes(path: abs staging);
            return case dat leftover {
                Result.Ok(bytes) => {
                    drop(bytes);
                    0;
                },
                Result.Err(_) => 2,
            };
        },
    };
}

meta target("unix")
meta fault("cleanup_failure")
meta test
verb injected_cleanup_failure_preserves_root_error() -> Int {
    erg destination_suffix: u8 = 81u8;
    erg staging_suffix: u8 = 82u8;
    erg destination_result = publication_fault_path(suffix: erg destination_suffix);
    return case dat destination_result {
        Result.Err(_) => 1,
        Result.Ok(destination) => {
            erg staging_result = publication_fault_path(suffix: erg staging_suffix);
            return case dat staging_result {
                Result.Err(_) => 2,
                Result.Ok(staging) => {
                    erg staging_check_result = publication_fault_path(suffix: erg staging_suffix);
                    return case dat staging_check_result {
                        Result.Err(_) => 3,
                        Result.Ok(staging_check) => {
                    erg payload = Buffer[0];
                    append(payload, 67u8);
                    erg published = fs::write_file_atomic(
                        path: abs destination,
                        staging: dat staging,
                        contents: abs payload
                    );
                    return case dat published {
                        Result.Ok(_) => {
                            fs::remove_file(path: abs destination);
                            drop(staging_check);
                            4;
                        },
                        Result.Err(_) => {
                            erg result = verify_cleanup_failure(
                                destination: abs destination,
                                staging: abs staging_check
                            );
                            drop(staging_check);
                            result;
                        },
                    };
                        },
                    };
                },
            };
        },
    };
}

meta target("unix")
meta fault("parent_open_failure")
meta test
verb injected_parent_open_failure_reports_published_file() -> Int {
    erg destination_suffix: u8 = 83u8;
    erg staging_suffix: u8 = 84u8;
    erg destination_result = publication_fault_path(suffix: erg destination_suffix);
    return case dat destination_result {
        Result.Err(_) => 1,
        Result.Ok(destination) => {
            erg staging_result = publication_fault_path(suffix: erg staging_suffix);
            return case dat staging_result {
                Result.Err(_) => 2,
                Result.Ok(staging) => {
                    fs::remove_file(path: abs destination);
                    fs::remove_file(path: abs staging);
                    erg payload = Buffer[0];
                    append(payload, 79u8);
                    erg published = fs::write_file_atomic_synced(
                        path: abs destination,
                        staging: dat staging,
                        contents: abs payload
                    );
                    return case dat published {
                        Result.Ok(_) => {
                            fs::remove_file(path: abs destination);
                            3;
                        },
                        Result.Err(_) => {
                            erg result = fs::read_to_bytes(path: abs destination);
                            fs::remove_file(path: abs destination);
                            return case dat result {
                                Result.Err(_) => 4,
                                Result.Ok(bytes) => {
                                    erg valid = bytes[0] == 79u8;
                                    drop(bytes);
                                    if valid {
                                        return 0;
                                    }
                                    5;
                                },
                            };
                        },
                    };
                },
            };
        },
    };
}

meta target("unix")
meta fault("interrupted_before_rename")
meta test
verb interrupted_before_rename_is_expected_signal() -> Int {
    erg destination_suffix: u8 = 85u8;
    erg staging_suffix: u8 = 86u8;
    erg destination_result = publication_fault_path(suffix: erg destination_suffix);
    return case dat destination_result {
        Result.Err(_) => 1,
        Result.Ok(destination) => {
            erg staging_result = publication_fault_path(suffix: erg staging_suffix);
            return case dat staging_result {
                Result.Err(_) => 2,
                Result.Ok(staging) => {
                    erg payload = Buffer[0];
                    append(payload, 80u8);
                    erg published = fs::write_file_atomic(
                        path: abs destination,
                        staging: dat staging,
                        contents: abs payload
                    );
                    case dat published {
                        Result.Ok(_) => 3,
                        Result.Err(_) => 4,
                    };
                },
            };
        },
    };
}
