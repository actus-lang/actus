"""Executable coverage for the volatile effect and register layout contract."""

"""This layout declaration does not make ordinary field access volatile."""
meta repr(C)
meta volatile
struct UartRegisters {
    status: u32,
    data: u8,
}

meta effect("volatile")
verb volatile_leaf() -> Int {
    return 7;
}

meta effect("volatile")
meta test
verb volatile_effect_must_be_declared_at_the_caller() -> Int {
    erg value = volatile_leaf();
    if value == 7 {
        return 0;
    }
    return 1;
}
