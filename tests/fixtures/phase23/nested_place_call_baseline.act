struct Column {
    erg axon_0: Int,
}

struct Fabric {
    erg columns: Array[Column, 2],
}

verb notify(erg value: Int) -> Void {
    return;
}

verb main() -> Int {
    erg fabric: Fabric = Fabric { columns: Array[Column, 2]() };
    erg index: Usize = 0;
    if index == 0 {
        fabric.columns[index].axon_0 = 1;
        notify(value: fabric.columns[index].axon_0);
    }
    return 0;
}
