"""Negative application fixture: a missing file must become IoError.Failed."""
import {
    open path,
    open fs,
    open io,
};

"""
contract:
purpose:
    Build the relative path `missing_192` from raw ASCII bytes, naming a file
    that does not exist.
outputs:
    `Ok(path)` with the new path, or the `PathError` of the path module.
ownership:
    The raw buffer is consumed by the path constructor; the result is a newly
    owned path.
side_effects:
    Allocates the raw byte buffer and the path.
"""
verb missing_path() -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append(raw, 109);
    append(raw, 105);
    append(raw, 115);
    append(raw, 115);
    append(raw, 105);
    append(raw, 110);
    append(raw, 103);
    append(raw, 95);
    append(raw, 49);
    append(raw, 57);
    append(raw, 50);
    append(raw, 0);
    return path_from_posix(storage: dat raw);
}

"""
contract:
purpose:
    Read a file that does not exist and check that the failure is the typed
    `IoError.Failed`.
outputs:
    0 when the read fails with `Failed`; 1 when the path cannot be built; 2 to
    9 for any other I/O error; 5 when the missing file was unexpectedly read.
side_effects:
    Blocking filesystem read of the relative path `missing_192`.
"""
meta effect("filesystem", "blocking")
verb main() -> Int {
    erg parsed = missing_path();
    return case dat parsed {
        Result.Err(_) => 1,
        Result.Ok(path) => {
            erg result = read_to_bytes(path: abs path);
            return case dat result {
                Result.Err(error) => case dat error {
                    IoError.Failed => 0,
                    IoError.EndOfStream => 2,
                    IoError.InvalidInput => 3,
                    IoError.InvalidData => 4,
                    IoError.Unsupported => 5,
                    IoError.PermissionDenied => 6,
                    IoError.Busy => 7,
                    IoError.CrossDevice => 8,
                    IoError.AlreadyExists => 9,
                },
                Result.Ok(bytes) => {
                    drop(bytes);
                    return 5;
                },
            };
        },
    };
}
