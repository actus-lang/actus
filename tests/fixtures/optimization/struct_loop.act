"""A struct built and borrowed in every iteration of a loop."""
struct Point {
    x: Int,
    y: Int,
}

verb sum(abs self: Point) -> Int {
    return self.x + self.y;
}

verb main() -> Int {
    erg total = 0;
    erg i = 0;
    loop {
        if i == 1000000 {
            break;
        }
        erg p = Point {
            x: i % 7,
            y: 1,
        };
        abs view = ref p;
        total = total + view.sum();
        i = i + 1;
    }
    return total % 100;
}
