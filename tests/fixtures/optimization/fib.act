"""Recursive Fibonacci: calls and return values."""
verb fib(erg n: u64) -> u64 {
    if n < 2 {
        return n;
    }
    erg left = n - 1;
    erg right = n - 2;
    return fib(n: erg left) + fib(n: erg right);
}

verb main() -> Int {
    erg start: u64 = 24;
    return (fib(n: erg start) % 256) as Int;
}
