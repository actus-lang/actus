"""Sieve of Eratosthenes below 10 000: array indexing in nested loops."""
verb main() -> Int {
    erg composite: Array[u8, 10000] = Array[u8, 10000]();
    erg count: u64 = 0;
    erg candidate: u64 = 2;
    loop {
        if candidate >= 10000 {
            break;
        }
        if composite[candidate] == 0 {
            count = count + 1;
            erg multiple = candidate * candidate;
            loop {
                if multiple >= 10000 {
                    break;
                }
                composite[multiple] = 1;
                multiple = multiple + candidate;
            }
        }
        candidate = candidate + 1;
    }
    return (count % 256) as Int;
}
