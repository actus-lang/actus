"""
Bounded fragmentation and reassembly primitives for `std::wire`.

Fragment metadata is an application payload prefix outside the canonical
version-one frame header. The metadata is versioned independently and carries
the message extent, fragment index, byte offset, count, and lifecycle
generation. Reassembly owns one caller-provided bounded buffer and records at
most 64 accepted non-overlapping ranges. It performs no allocation, I/O, or
unbounded scanning.
"""
"""Supported version of the fragmentation metadata prefix."""
open const WIRE_FRAGMENT_VERSION: u8 = 1u8;


"""Number of bytes occupied by one fragmentation metadata prefix."""
open const WIRE_FRAGMENT_HEADER_BYTES: u32 = 17u32;


"""Maximum number of fragments tracked by one reassembly."""
open const WIRE_FRAGMENT_MAX_COUNT: u16 = 64u16;


"""Maximum payload bytes accepted in one fragment."""
open const WIRE_FRAGMENT_MAX_PAYLOAD_BYTES: u32 = 1024u32;


"""Maximum complete message size accepted by the bounded reassembler."""
open const WIRE_REASSEMBLY_MAX_BYTES: u32 = 4096u32;


"""Versioned fixed-layout metadata prefix carried in a frame payload."""
open pack WireFragmentHeader {
    """Fixed storage for the metadata prefix in wire byte order."""
    erg storage: Array[u8, 17];
    layout little;
    fields {
        """Owned erg metadata version; it is copied by value and does not own storage."""
        erg version: u8 at 0;
        """Owned erg index value identifying this fragment; it has no independent cleanup."""
        erg fragment_index: u16 at 8;
        """Owned erg count value retained by the header; it is scalar metadata without cleanup."""
        erg fragment_count: u16 at 24;
        """Owned erg length value describing the message; it is scalar metadata without cleanup."""
        erg total_length: u32 at 40;
        """Owned erg offset value used for placement; it is scalar metadata without cleanup."""
        erg offset: u32 at 72;
        """Owned erg generation value used for lifecycle matching; it has no independent cleanup."""
        erg generation: u32 at 104;
    }
}

"""Caller-owned bounded state for one in-flight fragmented message."""
open struct WireReassembly {
    """Caller-provided storage receiving the complete message."""
    erg storage: Buffer,
    """Accepted fragment byte offsets indexed by fragment position."""
    erg ranges_offset: Array[u32, 64],
    """Accepted fragment lengths indexed by fragment position."""
    erg ranges_length: Array[u32, 64],
    """Declared complete message length."""
    erg total_length: u32,
    """Owned erg declared number of fragments."""
    erg fragment_count: u16,
    """Owned erg number of distinct accepted fragments."""
    erg received_count: u16,
    """Number of payload bytes copied into storage."""
    erg received_bytes: u32,
    """Owned erg active generation used to reject stale fragments."""
    erg generation: u32,
    """Lifecycle state: zero idle, one collecting, two complete."""
    erg state: u8,
}

verb wire_fragment_header_valid(
    abs metadata: WireFragmentHeader,
    erg payload_length: u32
) -> Result[Int, WireError] {
    if metadata.version != WIRE_FRAGMENT_VERSION {
        return Result[Int, WireError].Err(WireError.FragmentUnsupportedVersion);
    }
    if metadata.fragment_count == 0u16 || metadata.fragment_count > WIRE_FRAGMENT_MAX_COUNT {
        return Result[Int, WireError].Err(WireError.FragmentCountInvalid);
    }
    if metadata.fragment_index >= metadata.fragment_count {
        return Result[Int, WireError].Err(WireError.FragmentIndexInvalid);
    }
    if payload_length > WIRE_FRAGMENT_MAX_PAYLOAD_BYTES {
        return Result[Int, WireError].Err(WireError.FragmentTooLarge);
    }
    if metadata.total_length == 0u32 || metadata.total_length > WIRE_REASSEMBLY_MAX_BYTES {
        return Result[Int, WireError].Err(WireError.FragmentRangeInvalid);
    }
    if metadata.offset > metadata.total_length || payload_length > metadata.total_length - metadata.offset {
        return Result[Int, WireError].Err(WireError.FragmentRangeInvalid);
    }
    return Result[Int, WireError].Ok(0);
}

"""
Encode fragment metadata and payload into caller-owned storage.

The input payload is borrowed and the output is mutated in place. The result
contains the total encoded byte count. The operation validates every bounded
field before writing and never allocates or performs I/O.
"""
open verb wire_fragment_encode(
    abs header: WireFragmentHeader,
    abs payload: Buffer,
    ins output: Buffer
) -> Result[u32, WireError] {
    erg payload_length: u32 = buffer_length(buffer: abs payload) as u32;
    erg valid = wire_fragment_header_valid(metadata: abs header, payload_length: erg payload_length);
    case dat valid {
        Result.Err(error) => {
            return Result[u32, WireError].Err(error);
        },
        Result.Ok(_) => {},
    };
    erg required: u32 = WIRE_FRAGMENT_HEADER_BYTES + payload_length;
    if (buffer_length(buffer: abs output) as u32) < required {
        return Result[u32, WireError].Err(WireError.InsufficientCapacity);
    }
    output[0] = header.version;
    output[1] = (header.fragment_index & 255u16) as u8;
    output[2] = ((header.fragment_index >> 8u16) & 255u16) as u8;
    output[3] = (header.fragment_count & 255u16) as u8;
    output[4] = ((header.fragment_count >> 8u16) & 255u16) as u8;
    output[5] = (header.total_length & 255u32) as u8;
    output[6] = ((header.total_length >> 8u32) & 255u32) as u8;
    output[7] = ((header.total_length >> 16u32) & 255u32) as u8;
    output[8] = ((header.total_length >> 24u32) & 255u32) as u8;
    output[9] = (header.offset & 255u32) as u8;
    output[10] = ((header.offset >> 8u32) & 255u32) as u8;
    output[11] = ((header.offset >> 16u32) & 255u32) as u8;
    output[12] = ((header.offset >> 24u32) & 255u32) as u8;
    output[13] = (header.generation & 255u32) as u8;
    output[14] = ((header.generation >> 8u32) & 255u32) as u8;
    output[15] = ((header.generation >> 16u32) & 255u32) as u8;
    output[16] = ((header.generation >> 24u32) & 255u32) as u8;
    erg index: u32 = 0u32;
    loop {
        if index >= payload_length {
            break;
        }
        output[WIRE_FRAGMENT_HEADER_BYTES + index] = payload[index];
        index += 1u32;
    }
    return Result[u32, WireError].Ok(required);
}

"""
Decode and validate the fixed metadata prefix from a fragment payload.

The `abs` input is a borrowed read-only source. The verb returns a fixed-layout
metadata result or a typed truncation, version, count, range, or capacity
error. It performs no allocation, I/O, mutation, or cleanup.
"""
open verb wire_fragment_decode(abs input: Buffer) -> Result[WireFragmentHeader, WireError] {
    if (buffer_length(buffer: abs input) as u32) < WIRE_FRAGMENT_HEADER_BYTES {
        return Result[WireFragmentHeader, WireError].Err(WireError.Truncated);
    }
    erg fragment_header = WireFragmentHeader {storage: Array[u8, 17]()};
    fragment_header.version = input[0];
    fragment_header.fragment_index = (input[1] as u16) | ((input[2] as u16) << 8u16);
    fragment_header.fragment_count = (input[3] as u16) | ((input[4] as u16) << 8u16);
    fragment_header.total_length = (input[5] as u32) | ((input[6] as u32) << 8u32) | ((input[7] as u32) << 16u32) | ((input[8] as u32) << 24u32);
    fragment_header.offset = (input[9] as u32) | ((input[10] as u32) << 8u32) | ((input[11] as u32) << 16u32) | ((input[12] as u32) << 24u32);
    fragment_header.generation = (input[13] as u32) | ((input[14] as u32) << 8u32) | ((input[15] as u32) << 16u32) | ((input[16] as u32) << 24u32);
    erg payload_length: u32 = (buffer_length(buffer: abs input) as u32) - WIRE_FRAGMENT_HEADER_BYTES;
    if fragment_header.version != WIRE_FRAGMENT_VERSION {
        return Result[WireFragmentHeader, WireError].Err(WireError.FragmentUnsupportedVersion);
    }
    if fragment_header.fragment_count == 0u16 || fragment_header.fragment_count > WIRE_FRAGMENT_MAX_COUNT {
        return Result[WireFragmentHeader, WireError].Err(WireError.FragmentCountInvalid);
    }
    if fragment_header.fragment_index >= fragment_header.fragment_count {
        return Result[WireFragmentHeader, WireError].Err(WireError.FragmentIndexInvalid);
    }
    if payload_length > WIRE_FRAGMENT_MAX_PAYLOAD_BYTES {
        return Result[WireFragmentHeader, WireError].Err(WireError.FragmentTooLarge);
    }
    if fragment_header.total_length == 0u32 || fragment_header.total_length > WIRE_REASSEMBLY_MAX_BYTES {
        return Result[WireFragmentHeader, WireError].Err(WireError.FragmentRangeInvalid);
    }
    if fragment_header.offset > fragment_header.total_length || payload_length > fragment_header.total_length - fragment_header.offset {
        return Result[WireFragmentHeader, WireError].Err(WireError.FragmentRangeInvalid);
    }
    return Result[WireFragmentHeader, WireError].Ok(fragment_header);
}

"""
Open reassembly over caller-provided storage without allocating a buffer.

The `dat` storage ownership is transferred into the returned reassembly state,
which owns cleanup of that buffer at scope end. The verb returns an initialized
state handle; it performs no allocation or I/O and reports later capacity
failure through `wire_reassembly_begin`.
"""
open verb wire_reassembly_open(dat storage: Buffer) -> WireReassembly {
    return WireReassembly {storage: storage, ranges_offset: Array[u32, 64](), ranges_length: Array[u32, 64](
    ), total_length: 0u32, fragment_count: 0u16, received_count: 0u16, received_bytes: 0u32, generation: 0u32, state: 0u8};
}

"""Start one generation and reject messages larger than caller storage."""
open verb wire_reassembly_begin(
    ins reassembly: WireReassembly,
    erg total_length: u32,
    erg fragment_count: u16,
    erg generation: u32
) -> Result[Int, WireError] {
    if total_length == 0u32 || total_length > WIRE_REASSEMBLY_MAX_BYTES {
        return Result[Int, WireError].Err(WireError.FragmentRangeInvalid);
    }
    if fragment_count == 0u16 || fragment_count > WIRE_FRAGMENT_MAX_COUNT {
        return Result[Int, WireError].Err(WireError.FragmentCountInvalid);
    }
    if (buffer_length(buffer: abs reassembly.storage) as u32) < total_length {
        return Result[Int, WireError].Err(WireError.ReassemblyCapacity);
    }
    reassembly.total_length = total_length;
    reassembly.fragment_count = fragment_count;
    reassembly.received_count = 0u16;
    reassembly.received_bytes = 0u32;
    reassembly.generation = generation;
    reassembly.state = 1u8;
    return Result[Int, WireError].Ok(0);
}

verb wire_reassembly_overlaps(
    abs reassembly: WireReassembly,
    erg candidate_offset: u32,
    erg payload_length: u32
) -> Bool {
    erg candidate_end: u32 = candidate_offset + payload_length;
    for erg index: u32 in 0u32 .. (WIRE_FRAGMENT_MAX_COUNT as u32) {
        if index >= (reassembly.received_count as u32) {
            break;
        }
        erg existing_start: u32 = reassembly.ranges_offset[index];
        erg existing_end: u32 = existing_start + reassembly.ranges_length[index];
        if candidate_offset < existing_end && existing_start < candidate_end {
            return true;
        }
    }
    return false;
}

"""
Accept one fragment, copy it into the active storage, and report completion.

The `ins` reassembly is an exclusive mutable loan and the `abs` fragment is a
borrowed read-only input; both roles end at return. The result reports incomplete
or complete status, while typed errors reject stale, duplicate, overlapping,
malformed, out-of-range, and exhausted input. The operation uses existing
caller storage only, performs no allocation or I/O, and leaves cleanup to the
reassembly lifecycle.
"""
open verb wire_reassembly_accept(
    ins reassembly: WireReassembly,
    abs fragment: Buffer
) -> Result[Int, WireError] {
    if reassembly.state != 1u8 {
        return Result[Int, WireError].Err(WireError.ReassemblyState);
    }
    erg fragment_length: u32 = buffer_length(buffer: abs fragment) as u32;
    if fragment_length < WIRE_FRAGMENT_HEADER_BYTES {
        return Result[Int, WireError].Err(WireError.Truncated);
    }
    erg fragment_version: u8 = fragment[0];
    erg fragment_index: u16 = (fragment[1] as u16) | ((fragment[2] as u16) << 8u16);
    erg fragment_count: u16 = (fragment[3] as u16) | ((fragment[4] as u16) << 8u16);
    erg total_length: u32 = (fragment[5] as u32) | ((fragment[6] as u32) << 8u32) | ((fragment[7] as u32) << 16u32) | ((fragment[8] as u32) << 24u32);
    erg fragment_offset: u32 = (fragment[9] as u32) | ((fragment[10] as u32) << 8u32) | ((fragment[11] as u32) << 16u32) | ((fragment[12] as u32) << 24u32);
    erg fragment_generation: u32 = (fragment[13] as u32) | ((fragment[14] as u32) << 8u32) | ((fragment[15] as u32) << 16u32) | ((fragment[16] as u32) << 24u32);
    if fragment_generation != reassembly.generation {
        return Result[Int, WireError].Err(WireError.FragmentStale);
    }
    if fragment_version != WIRE_FRAGMENT_VERSION {
        return Result[Int, WireError].Err(WireError.FragmentUnsupportedVersion);
    }
    if fragment_count == 0u16 || fragment_count > WIRE_FRAGMENT_MAX_COUNT || fragment_index >= fragment_count {
        return Result[Int, WireError].Err(WireError.FragmentCountInvalid);
    }
    if total_length != reassembly.total_length || fragment_count != reassembly.fragment_count {
        return Result[Int, WireError].Err(WireError.FragmentRangeInvalid);
    }
    erg payload_length: u32 = fragment_length - WIRE_FRAGMENT_HEADER_BYTES;
    if payload_length > WIRE_FRAGMENT_MAX_PAYLOAD_BYTES || fragment_offset > total_length || payload_length > total_length - fragment_offset {
        return Result[Int, WireError].Err(WireError.FragmentRangeInvalid);
    }
    erg index: u32 = fragment_index as u32;
    if reassembly.ranges_length[index] != 0u32 {
        return Result[Int, WireError].Err(WireError.FragmentDuplicate);
    }
    if wire_reassembly_overlaps(
        reassembly: abs reassembly,
        candidate_offset: erg fragment_offset,
        payload_length: erg payload_length
    ) {
        return Result[Int, WireError].Err(WireError.FragmentOverlap);
    }
    erg payload_index: u32 = 0u32;
    loop {
        if payload_index >= payload_length {
            break;
        }
        reassembly.storage[fragment_offset + payload_index] = fragment[WIRE_FRAGMENT_HEADER_BYTES + payload_index];
        payload_index += 1u32;
    }
    reassembly.ranges_offset[index] = fragment_offset;
    reassembly.ranges_length[index] = payload_length;
    reassembly.received_count += 1u16;
    reassembly.received_bytes += payload_length;
    if reassembly.received_count == reassembly.fragment_count {
        reassembly.state = 2u8;
        return Result[Int, WireError].Ok(1);
    }
    return Result[Int, WireError].Ok(0);
}

"""
Copy a complete message to caller storage and leave reassembly state intact.

The `abs` reassembly is borrowed without consuming ownership and the `ins`
output is an exclusive caller-owned buffer mutated in place. The result returns
the copied byte count or a typed incomplete/capacity error. No allocation or
I/O occurs and no cleanup or ownership transfer is performed.
"""
open verb wire_reassembly_copy(abs reassembly: WireReassembly, ins output: Buffer) -> Result[u32, WireError] {
    if reassembly.state != 2u8 {
        return Result[u32, WireError].Err(WireError.ReassemblyIncomplete);
    }
    if (buffer_length(buffer: abs output) as u32) < reassembly.total_length {
        return Result[u32, WireError].Err(WireError.InsufficientCapacity);
    }
    erg index: u32 = 0u32;
    loop {
        if index >= reassembly.total_length {
            break;
        }
        output[index] = reassembly.storage[index];
        index += 1u32;
    }
    return Result[u32, WireError].Ok(reassembly.total_length);
}

"""
Cancel the active generation and make the storage reusable.

The `ins` reassembly loan mutates lifecycle state in place; ownership remains
with the caller and cleanup is still performed by the reassembly owner. The
verb returns `Void`, performs no allocation or I/O, and clears pending ranges
without releasing the caller-provided buffer.
"""
open verb wire_reassembly_cancel(ins reassembly: WireReassembly) -> Void {
    reassembly.total_length = 0u32;
    reassembly.fragment_count = 0u16;
    reassembly.received_count = 0u16;
    reassembly.received_bytes = 0u32;
    reassembly.state = 0u8;
}
