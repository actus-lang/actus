"""
Optional hosted endpoint parsing for `std::wire`.

This module recognizes the bounded `wire://authority[:port][/path]` address
form without creating a String, allocating storage, or contacting a transport.
The returned fixed-layout value contains offsets and lengths into the caller's
unchanged byte buffer. The core frame codec does not depend on this module;
embedded users may omit it and exchange frames through numeric identifiers.
"""
open const WIRE_ENDPOINT_SCHEME_BYTES: u32 = 7u32;
open const WIRE_ENDPOINT_MAX_BYTES: u32 = 256u32;
open const WIRE_ENDPOINT_MAX_AUTHORITY_BYTES: u32 = 128u32;
open const WIRE_ENDPOINT_MAX_PATH_BYTES: u32 = 128u32;
open const WIRE_ENDPOINT_DEFAULT_PORT: u32 = 0u32;

"""Typed failures for bounded, transport-neutral endpoint parsing."""
open enum WireEndpointError {
    """The source exceeds the bounded endpoint representation."""
    TooLong,
    """The source does not begin with the exact `wire://` scheme."""
    InvalidScheme,
    """The authority component is absent or empty."""
    MissingAuthority,
    """The authority contains a forbidden or malformed byte."""
    InvalidAuthority,
    """The port separator is not followed by decimal digits."""
    InvalidPort,
    """The decimal port is outside the u16 transport range."""
    PortOutOfRange,
    """The path contains a forbidden control byte or exceeds its bound."""
    InvalidPath,
}

"""
Fixed-layout view of a parsed endpoint.

Every field is owned erg scalar metadata. The view does not own or copy the
source bytes; authority and path offsets remain valid only while the caller's
abs input buffer remains available. No field requires cleanup or allocation.
"""
open pack WireEndpoint {
    """Owned fixed metadata storage; it carries no source bytes or cleanup resource."""
    erg storage: Array[u8, 32];
    layout little;
    fields {
        """Owned erg source length used to validate endpoint views."""
        erg source_length: u32 at 0;
        """Owned erg authority start offset in the caller buffer."""
        erg authority_offset: u32 at 32;
        """Owned erg authority byte length."""
        erg authority_length: u32 at 64;
        """Owned erg decimal port, or zero when no port was supplied."""
        erg port: u32 at 96;
        """Owned erg flag: one when an explicit port was present."""
        erg has_port: u32 at 128;
        """Owned erg path start offset, or zero when no path was supplied."""
        erg path_offset: u32 at 160;
        """Owned erg path byte length."""
        erg path_length: u32 at 192;
        """Owned erg validity marker for metadata returned by the parser."""
        erg valid: u32 at 224;
    }
}

"""
Decide whether one byte may appear in the authority part of a `wire://`
endpoint: it must be a printable non-space byte other than the delimiters `/`,
`:`, `?` and `#`. The byte is a copied scalar; the function performs no I/O and
no allocation.
"""
verb wire_endpoint_is_authority_byte(erg byte: u8) -> Bool {
    return byte > 32u8 && byte != 47u8 && byte != 58u8 && byte != 63u8 && byte != 35u8;
}

"""
Decide whether one byte may appear in the path part of a `wire://` endpoint: it
must be a printable byte of value 32 or above, which excludes NUL and control
bytes. The byte is a copied scalar; the function performs no I/O and no
allocation.
"""
verb wire_endpoint_is_path_byte(erg byte: u8) -> Bool {
    return byte >= 32u8 && byte != 0u8;
}

"""
Check that the buffer starts with the seven bytes `wire://`. The input is an
immutable `abs` view; the caller must already have verified that it is at least
as long as the scheme, because the function reads the first seven bytes without
a bounds check of its own. It returns `true` only for an exact match.
"""
verb wire_endpoint_check_scheme(abs input: Buffer) -> Bool {
    return input[0] == 119u8 && input[1] == 105u8 && input[2] == 114u8 && input[3] == 101u8
        && input[4] == 58u8 && input[5] == 47u8 && input[6] == 47u8;
}

"""
Find where the current endpoint component ends: the index of the first `/` or
`:` at or after `start`, or the input length when neither occurs. The input is
an immutable `abs` view; the scan is bounded by the maximum endpoint size, so
the loop always terminates. The function reads only and allocates nothing.
"""
verb wire_endpoint_find_boundary(abs input: Buffer, erg start: u32) -> u32 {
    erg length: u32 = buffer_length(buffer: abs input) as u32;
    for erg index: u32 in start..WIRE_ENDPOINT_MAX_BYTES {
        if index >= length || input[index] == 47u8 || input[index] == 58u8 {
            return index;
        }
    }
    return length;
}

"""
Check that every byte of the authority range `start..end` is allowed by
`wire_endpoint_is_authority_byte`. The input is an immutable `abs` view; the scan
is bounded by the maximum authority size. It returns `false` at the first
disallowed byte and `true` when the whole range is acceptable. The function
reads only and allocates nothing.
"""
verb wire_endpoint_validate_authority(
    abs input: Buffer,
    erg start: u32,
    erg end: u32
) -> Bool {
    for erg index: u32 in start..WIRE_ENDPOINT_MAX_AUTHORITY_BYTES {
        if index >= end {
            break;
        }
        erg byte: u8 = input[index];
        if !wire_endpoint_is_authority_byte(byte: erg byte) {
            return false;
        }
    }
    return true;
}

"""
contract:
purpose:
    Parse the decimal port that follows the authority colon.
inputs:
    input: the endpoint text; start and end: the byte range of the digits.
outputs:
    `Ok(port)` in the range 1 to 65535, or a typed `WireEndpointError`.
ownership:
    The input is an immutable `abs` view and is not modified.
errors:
    `InvalidPort` for an empty range, more than five digits or a non-digit
    byte; `PortOutOfRange` for zero or a value above 65535.
"""
verb wire_endpoint_parse_port(
    abs input: Buffer,
    erg start: u32,
    erg end: u32
) -> Result[u32, WireEndpointError] {
    if start >= end || end - start > 5u32 {
        return Result[u32, WireEndpointError].Err(WireEndpointError.InvalidPort);
    }
    erg value: u32 = 0u32;
    for erg index: u32 in start..WIRE_ENDPOINT_MAX_BYTES {
        if index >= end {
            break;
        }
        erg byte: u8 = input[index];
        if byte < 48u8 || byte > 57u8 {
            return Result[u32, WireEndpointError].Err(WireEndpointError.InvalidPort);
        }
        value = value * 10u32 + (byte as u32) - 48u32;
    }
    if value == 0u32 || value > 65535u32 {
        return Result[u32, WireEndpointError].Err(WireEndpointError.PortOutOfRange);
    }
    return Result[u32, WireEndpointError].Ok(value);
}

"""
Check that the path range `start..end` is no longer than the maximum path size
and that every byte passes `wire_endpoint_is_path_byte`. The input is an
immutable `abs` view; the scan is bounded. It returns `false` for an over-long
path or the first disallowed byte and `true` otherwise. The function reads only
and allocates nothing.
"""
verb wire_endpoint_validate_path(abs input: Buffer, erg start: u32, erg end: u32) -> Bool {
    if end - start > WIRE_ENDPOINT_MAX_PATH_BYTES {
        return false;
    }
    for erg index: u32 in start..WIRE_ENDPOINT_MAX_BYTES {
        if index >= end {
            break;
        }
        erg byte: u8 = input[index];
        if !wire_endpoint_is_path_byte(byte: erg byte) {
            return false;
        }
    }
    return true;
}

"""
contract:
purpose:
    Read an optional `:port` after the authority and record it in the endpoint
    metadata.
inputs:
    input: the endpoint text; authority_end: offset after the authority;
    endpoint: the metadata being filled.
outputs:
    `Ok(offset)` of the first byte after the port, which is `authority_end`
    when no port is present, or a typed `WireEndpointError`.
ownership:
    The input is an immutable `abs` view; the endpoint is an exclusive `ins`
    loan.
side_effects:
    Sets `port` and `has_port` of the endpoint when a port is present.
errors:
    Any port error from `wire_endpoint_parse_port`.
"""
verb wire_endpoint_apply_port(
    abs input: Buffer,
    erg authority_end: u32,
    ins endpoint: WireEndpoint
) -> Result[u32, WireEndpointError] {
    if input[authority_end] != 58u8 {
        return Result[u32, WireEndpointError].Ok(authority_end);
    }
    erg port_start: u32 = authority_end + 1u32;
    erg path_start: u32 = wire_endpoint_find_boundary(input: abs input, start: erg port_start);
    erg parsed_port = wire_endpoint_parse_port(
        input: abs input,
        start: erg port_start,
        end: erg path_start
    );
    endpoint.port = case dat parsed_port {
        Result.Err(error) => {
            return Result[u32, WireEndpointError].Err(error);
        },
        Result.Ok(value) => value,
    };
    endpoint.has_port = 1u32;
    return Result[u32, WireEndpointError].Ok(path_start);
}

"""
contract:
purpose:
    Validate the optional path that follows the authority and port and record
    its position in the endpoint metadata.
inputs:
    input: the endpoint text; suffix_start: offset where the suffix begins;
    length: total endpoint length; endpoint: the metadata being filled.
outputs:
    `Ok(0)` when there is no suffix or the path is accepted, or a typed
    `WireEndpointError`.
ownership:
    The input is an immutable `abs` view; the endpoint is an exclusive `ins`
    loan.
side_effects:
    Sets `path_offset` and `path_length` of the endpoint when a path exists.
errors:
    `InvalidAuthority` when the suffix does not start with `/`, and
    `InvalidPath` when the path is too long or has a disallowed byte.
"""
verb wire_endpoint_apply_path(
    abs input: Buffer,
    erg suffix_start: u32,
    erg length: u32,
    ins endpoint: WireEndpoint
) -> Result[Int, WireEndpointError] {
    if suffix_start == length {
        return Result[Int, WireEndpointError].Ok(0);
    }
    if input[suffix_start] != 47u8 {
        return Result[Int, WireEndpointError].Err(WireEndpointError.InvalidAuthority);
    }
    if !wire_endpoint_validate_path(
        input: abs input,
        start: erg suffix_start,
        end: erg length
    ) {
        return Result[Int, WireEndpointError].Err(WireEndpointError.InvalidPath);
    }
    endpoint.path_offset = suffix_start;
    endpoint.path_length = length - suffix_start;
    return Result[Int, WireEndpointError].Ok(0);
}

"""
contract:
purpose:
    Parse everything after the authority: the optional port and then the
    optional path.
inputs:
    input: the endpoint text; authority_end: offset after the authority;
    length: total endpoint length; endpoint: the metadata being filled.
outputs:
    `Ok(0)` when the suffix is valid, or a typed `WireEndpointError`.
ownership:
    The input is an immutable `abs` view; the endpoint is an exclusive `ins`
    loan.
side_effects:
    Fills the port and path fields of the endpoint.
errors:
    The first error of `wire_endpoint_apply_port` or
    `wire_endpoint_apply_path`.
"""
verb wire_endpoint_apply_suffix(
    abs input: Buffer,
    erg authority_end: u32,
    erg length: u32,
    ins endpoint: WireEndpoint
) -> Result[Int, WireEndpointError] {
    erg port_end = wire_endpoint_apply_port(
        input: abs input,
        authority_end: erg authority_end,
        endpoint: ins endpoint
    );
    erg suffix_start: u32 = case dat port_end {
        Result.Err(error) => {
            return Result[Int, WireEndpointError].Err(error);
        },
        Result.Ok(value) => value,
    };
    return wire_endpoint_apply_path(
        input: abs input,
        suffix_start: erg suffix_start,
        length: erg length,
        endpoint: ins endpoint
    );
}

"""
Create the endpoint metadata record for an already validated authority: it
stores the source length, the authority offset and length, the default port, no
explicit port and no path, and marks the record valid. The arguments are copied
scalars. The result is a new owned `WireEndpoint` whose storage is a fixed
array, so nothing is allocated dynamically and no input is read.
"""
verb wire_endpoint_initialize(
    erg length: u32,
    erg authority_start: u32,
    erg authority_end: u32
) -> WireEndpoint {
    erg endpoint = WireEndpoint {
        storage: Array[u8, 32](),
    };
    endpoint.source_length = length;
    endpoint.authority_offset = authority_start;
    endpoint.authority_length = authority_end - authority_start;
    endpoint.port = WIRE_ENDPOINT_DEFAULT_PORT;
    endpoint.has_port = 0u32;
    endpoint.path_offset = 0u32;
    endpoint.path_length = 0u32;
    endpoint.valid = 1u32;
    return endpoint;
}

"""
contract:
purpose:
    Validate the `wire://` scheme and locate the authority part of an endpoint.
inputs:
    input: the endpoint text; length: its byte length.
outputs:
    `Ok(authority_end)`, the offset just after the authority, or a typed
    `WireEndpointError`.
ownership:
    The input is an immutable `abs` view and is not modified.
errors:
    `TooLong` above the maximum size, `InvalidScheme` for a missing or wrong
    scheme, `MissingAuthority` for an empty authority, and `InvalidAuthority`
    for an over-long authority or a disallowed byte.
"""
verb wire_endpoint_find_authority(
    abs input: Buffer,
    erg length: u32
) -> Result[u32, WireEndpointError] {
    if length > WIRE_ENDPOINT_MAX_BYTES {
        return Result[u32, WireEndpointError].Err(WireEndpointError.TooLong);
    }
    if length < WIRE_ENDPOINT_SCHEME_BYTES || !wire_endpoint_check_scheme(input: abs input) {
        return Result[u32, WireEndpointError].Err(WireEndpointError.InvalidScheme);
    }
    erg authority_start: u32 = WIRE_ENDPOINT_SCHEME_BYTES;
    erg authority_end: u32 = wire_endpoint_find_boundary(
        input: abs input,
        start: erg authority_start
    );
    if authority_end == authority_start {
        return Result[u32, WireEndpointError].Err(WireEndpointError.MissingAuthority);
    }
    if authority_end - authority_start > WIRE_ENDPOINT_MAX_AUTHORITY_BYTES || !wire_endpoint_validate_authority(
        input: abs input,
        start: erg authority_start,
        end: erg authority_end
    ) {
        return Result[u32, WireEndpointError].Err(WireEndpointError.InvalidAuthority);
    }
    return Result[u32, WireEndpointError].Ok(authority_end);
}

"""
Parse one optional `wire://authority[:port][/path]` endpoint.

The `abs` input is borrowed and remains unchanged; the returned `WireEndpoint`
contains scalar offsets into that input. This allocation-free verb performs no
I/O or cleanup and returns typed errors for bounds, scheme, authority, port,
and path violations. It does not select or open a transport.
"""
open verb wire_endpoint_parse(abs input: Buffer) -> Result[WireEndpoint, WireEndpointError] {
    erg length: u32 = buffer_length(buffer: abs input) as u32;
    erg authority_end_result = wire_endpoint_find_authority(input: abs input, length: erg length);
    erg authority_end: u32 = case dat authority_end_result {
        Result.Err(error) => {
            return Result[WireEndpoint, WireEndpointError].Err(error);
        },
        Result.Ok(value) => value,
    };
    erg authority_start: u32 = WIRE_ENDPOINT_SCHEME_BYTES;
    erg endpoint = wire_endpoint_initialize(
        length: erg length,
        authority_start: erg authority_start,
        authority_end: erg authority_end
    );
    erg suffix = wire_endpoint_apply_suffix(
        input: abs input,
        authority_end: erg authority_end,
        length: erg length,
        endpoint: ins endpoint
    );
    case dat suffix {
        Result.Err(error) => {
            return Result[WireEndpoint, WireEndpointError].Err(error);
        },
        Result.Ok(_) => {},
    };
    return Result[WireEndpoint, WireEndpointError].Ok(endpoint);
}
