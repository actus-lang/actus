"""
Typed failures for the bounded `std::wire` frame contract.

The error set distinguishes malformed framing, unsupported protocol policy,
capacity failure, and accidental corruption. CRC validation is integrity
detection only; these variants do not authenticate a sender or authorize a
message.
"""
open enum WireError {
    """The supplied bytes do not contain the required magic sequence."""
    InvalidMagic,
    """The frame version is not supported by this implementation."""
    UnsupportedVersion,
    """The frame contains a reserved or unknown flag bit."""
    UnknownFlags,
    """The encoded payload length exceeds the bounded protocol maximum."""
    PayloadTooLarge,
    """The supplied buffer is shorter than the requested frame operation."""
    Truncated,
    """The caller-provided output storage cannot hold the complete frame."""
    InsufficientCapacity,
    """The payload byte count does not match the header declaration."""
    PayloadLengthMismatch,
    """The frame checksum does not match its encoded contents."""
    ChecksumMismatch,
    """A bounded range has an invalid start or end position."""
    InvalidRange,
    """A reserved protocol operation is not enabled in version one."""
    PolicyRejected,
    """The sequence was already accepted in the active receipt window."""
    SequenceDuplicate,
    """The sequence is older than the retained receipt window."""
    SequenceStale,
    """The sequence advances farther than the bounded forward policy allows."""
    SequenceJumpTooLarge,
    """The sequence belongs to a context that is not active in this window."""
    SequenceContextMismatch,
    """The fragment metadata version is not supported."""
    FragmentUnsupportedVersion,
    """The fragment count is zero or exceeds the bounded reassembly limit."""
    FragmentCountInvalid,
    """The fragment index is outside the declared fragment set."""
    FragmentIndexInvalid,
    """The fragment offset and payload length exceed the message extent."""
    FragmentRangeInvalid,
    """The fragment payload is larger than the bounded fragment limit."""
    FragmentTooLarge,
    """The same fragment index was already accepted."""
    FragmentDuplicate,
    """The fragment range overlaps an accepted range."""
    FragmentOverlap,
    """The fragment generation does not match the active reassembly."""
    FragmentStale,
    """The reassembly storage cannot hold the declared message."""
    ReassemblyCapacity,
    """The reassembly operation is not active or is already complete."""
    ReassemblyState,
    """The caller requested a completed message before all fragments arrived."""
    ReassemblyIncomplete,
}
