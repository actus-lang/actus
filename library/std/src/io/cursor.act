"""
An in-memory stream backed by caller-provided storage.

`buffer` is owned by the cursor and `position` is its absolute byte offset.
"""
open struct Cursor {
    """Owned backing storage. The cursor drops this `erg` buffer with itself."""
    erg buffer: Buffer,
    """Absolute byte offset used by the next read or write operation."""
    erg position: Int,
}

"""Construct a cursor at position zero by transferring buffer ownership."""
open verb cursor(dat buffer: Buffer) -> Cursor {
    return Cursor { buffer: buffer, position: 0, };
}

"""Read bytes from a buffer position into a caller-owned destination."""
open unsafe extern "C" verb actus_cursor_read(
    abs source: Buffer,
    erg position: Int,
    ins target: Buffer
) -> Int;

"""Write a borrowed source buffer at a buffer position."""
open unsafe extern "C" verb actus_cursor_write(
    ins target: Buffer,
    erg position: Int,
    abs source: Buffer
) -> Int;

"""
Validate `position` against the backing storage in `buffer`.

`buffer` is exclusively borrowed for the bounds check and remains owned by
the cursor. Zero means the position is valid; `-1` means it is outside the
buffer and is translated to `IoError.Failed`.
"""
open unsafe extern "C" verb actus_cursor_seek(ins buffer: Buffer, erg position: Int) -> Int;

"""
Flush cursor state without an operating-system side effect.

`target` is an exclusive loan of the cursor's backing buffer. The bridge
returns zero for success or `-1` for a rejected operation.
"""
open unsafe extern "C" verb actus_cursor_flush(ins target: Buffer) -> Int;

"""Read from an in-memory cursor into an exclusive caller buffer."""
open verb cursor_read(ins self: Cursor, ins buffer: Buffer) -> Result[Int, IoError] {
    erg status = actus_cursor_read(source: abs self.buffer, position: self.position, target: ins buffer);
    case status {
        -1 => { self.position = self.position; },
        _ => { self.position = self.position + status; },
    };
    return case status {
        -1 => Err(IoError.Failed),
        0 => Err(IoError.EndOfStream),
        _ => Ok(status),
    };
}

"""Write an immutable source at the cursor's current position."""
open verb cursor_write(ins self: Cursor, abs buffer: Buffer) -> Result[Int, IoError] {
    erg status = actus_cursor_write(target: ins self.buffer, position: self.position, source: abs buffer);
    case status {
        -1 => { self.position = self.position; },
        _ => { self.position = self.position + status; },
    };
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}

"""Move a cursor to an absolute byte position within its backing buffer."""
open verb seek(ins self: Cursor, erg offset: Int) -> Result[Int, IoError] {
    erg status = actus_cursor_seek(buffer: ins self.buffer, position: offset);
    return case status {
        -1 => Err(IoError.Failed),
        _ => { self.position = offset; return Ok(status); },
    };
}

"""Flush a cursor without performing an operating-system operation."""
open verb cursor_flush(ins self: Cursor) -> Result[Int, IoError] {
    erg status = actus_cursor_flush(target: ins self.buffer);
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}

"""Satisfy the static Reader contract for Cursor."""
open perform Reader for Cursor {
    verb read(ins self: Cursor, ins buffer: Buffer) -> Result[Int, IoError] {
        erg status = actus_cursor_read(source: abs self.buffer, position: self.position, target: ins buffer);
        case status {
            -1 => { self.position = self.position; },
            _ => { self.position = self.position + status; },
        };
        return case status {
            -1 => Err(IoError.Failed),
            0 => Err(IoError.EndOfStream),
            _ => Ok(status),
        };
    }
}

"""Satisfy the static Writer contract for Cursor."""
open perform Writer for Cursor {
    verb write(ins self: Cursor, abs buffer: Buffer) -> Result[Int, IoError] {
        erg status = actus_cursor_write(target: ins self.buffer, position: self.position, source: abs buffer);
        case status {
            -1 => { self.position = self.position; },
            _ => { self.position = self.position + status; },
        };
        return case status {
            -1 => Err(IoError.Failed),
            _ => Ok(status),
        };
    }

    verb flush(ins self: Cursor) -> Result[Int, IoError] {
        erg status = actus_cursor_flush(target: ins self.buffer);
        return case status {
            -1 => Err(IoError.Failed),
            _ => Ok(status),
        };
    }
}
