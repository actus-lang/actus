/// An in-memory stream backed by caller-provided storage.
///
/// `buffer` is owned by the cursor. Reader and Writer implementations use
/// the same storage without allocating a second stream object.
open struct Cursor {
    erg buffer: Buffer,
}

/// Construct a cursor by transferring ownership of an in-memory buffer.
open verb cursor(dat buffer: Buffer) -> Cursor {
    return Cursor { buffer: buffer, };
}

/// Runtime bridge that copies cursor bytes into a caller-owned destination.
open unsafe extern "C" verb actus_cursor_read(
    abs source: Buffer,
    ins target: Buffer
) -> Int;

/// Runtime bridge that appends a borrowed source to cursor storage.
open unsafe extern "C" verb actus_cursor_write(
    ins target: Buffer,
    abs source: Buffer
) -> Int;

/// Cursor flushing is an in-memory no-op with a typed success result.
open unsafe extern "C" verb actus_cursor_flush(ins target: Buffer) -> Int;

/// Read from an in-memory cursor into an exclusive caller buffer.
open verb cursor_read(abs self: Cursor, ins buffer: Buffer) -> Result[Int, IoError] {
    erg status = actus_cursor_read(source: abs self.buffer, target: ins buffer);
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}

/// Append an immutable source to an in-memory cursor.
open verb cursor_write(ins self: Cursor, abs buffer: Buffer) -> Result[Int, IoError] {
    erg status = actus_cursor_write(target: ins self.buffer, source: abs buffer);
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}

/// Flush a cursor without performing an operating-system operation.
open verb cursor_flush(ins self: Cursor) -> Result[Int, IoError] {
    erg status = actus_cursor_flush(target: ins self.buffer);
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}

/// Satisfy the static Reader contract for Cursor.
perform Reader for Cursor {
    verb read(abs self: Cursor, ins buffer: Buffer) -> Result[Int, IoError] {
        erg status = actus_cursor_read(source: abs self.buffer, target: ins buffer);
        return case status {
            -1 => Err(IoError.Failed),
            _ => Ok(status),
        };
    }
}

/// Satisfy the static Writer contract for Cursor.
perform Writer for Cursor {
    verb write(ins self: Cursor, abs buffer: Buffer) -> Result[Int, IoError] {
        erg status = actus_cursor_write(target: ins self.buffer, source: abs buffer);
        return case status {
            -1 => Err(IoError.Failed),
            _ => Ok(status),
        };
    }

    verb flush(ins self: Cursor) -> Result[Int, IoError] {
        erg status = actus_cursor_flush(target: ins self.buffer);
        return case status {
            -1 => Err(IoError.Failed),
            _ => Ok(status),
        };
    }
}
