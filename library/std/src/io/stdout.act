"""
C ABI scalar output bridge. The `erg` role passes the integer value owned
by the call; the runtime returns an integer status wrapped by `print_int`.
"""
unsafe extern "C" verb actus_print_int(erg value: Int) -> Int;
"""C ABI bridge that reads a borrowed buffer, writes it to stdout, and returns a byte status."""
unsafe extern "C" verb actus_print_buffer_stdout(abs text: Buffer) -> Int;
"""C ABI bridge that writes a borrowed buffer followed by a newline and returns a byte status."""
unsafe extern "C" verb actus_print_line_buffer_stdout(abs text: Buffer) -> Int;
"""C ABI bridge that synchronizes stdout and returns zero or failure."""
unsafe extern "C" verb actus_flush_stdout() -> Int;

"""C ABI bridge that writes a borrowed string without adding a newline."""
unsafe extern "C" verb actus_write_string_stdout(abs text: String) -> Int;
"""C ABI bridge that writes a borrowed string followed by a newline."""
unsafe extern "C" verb actus_print_string(abs text: String) -> Int;

"""Print a borrowed string without adding a newline.

Returns `Result.Ok(count)` with the number of written bytes, or
`Result.Err(IoError.Failed)` when the runtime write fails.
"""
open verb print(abs text: String) -> Result[Int, IoError] {
    erg status = actus_write_string_stdout(text: abs text);
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}

"""Print a borrowed string and append a newline.

Returns `Result.Ok(count)` with the number of written bytes, or
`Result.Err(IoError.Failed)` when the runtime write fails.
"""
open verb println(abs text: String) -> Result[Int, IoError] {
    erg status = actus_print_string(text: abs text);
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}

"""Print an integer value to stdout and return its typed I/O result."""
open verb print_int(erg value: Int) -> Result[Int, IoError] {
    erg status = actus_print_int(value: value);
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}

"""Print borrowed bytes without consuming or modifying them.

Returns `Result.Ok(count)` with the number of written bytes, or
`Result.Err(IoError.Failed)` when the runtime write fails.
"""
open verb printb(abs text: Buffer) -> Result[Int, IoError] {
    erg status = actus_print_buffer_stdout(text: abs text);
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}

"""Print borrowed bytes, append a newline, and flush stdout immediately.

Returns `Result.Ok(count)` with the number of written bytes, or
`Result.Err(IoError.Failed)` when the runtime write or flush fails.
"""
open verb printlnb(abs text: Buffer) -> Result[Int, IoError] {
    erg status = actus_print_line_buffer_stdout(text: abs text);
    erg flushed = actus_flush_stdout();
    return case status {
        -1 => Err(IoError.Failed),
        _ => case flushed {
            0 => Ok(status),
            _ => Err(IoError.Failed),
        },
    };
}

"""
Flush pending stdout output and translate the native status into `Result`.
A successful flush returns `Ok(0)`; any non-zero runtime status is `Failed`.
"""
open verb flush() -> Result[Int, IoError] {
    erg status: Int = actus_flush_stdout();
    erg result: Result[Int, IoError] = case status {
        0 => Ok(0),
        _ => Err(IoError.Failed),
    };
    return result;
}
