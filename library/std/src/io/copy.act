"""
Reserve one reusable scratch allocation, then copy the next available chunk
from a statically selected reader to writer.

The reusable scratch buffer is allocated once for this operation. Concrete
Reader and Writer implementations are selected by generic monomorphization.
The copy-specific C bridge reserves that storage without retaining the buffer.
Only `EndOfStream` terminates the transfer successfully; all other errors
are returned to the caller unchanged.
"""
unsafe extern "C" verb actus_copy_buffer_reserve(
    ins buffer: Buffer,
    erg capacity: Int
) -> Int;

"""Preserve one writer failure while adapting it to the copy result type.

`error` is transferred as `dat` and consumed exactly once by the exhaustive
match. Every variant, including `PermissionDenied`, is returned unchanged in
`Err`; no buffer, writer, or native resource is allocated or retained.
"""
open verb copy_write_error(dat error: IoError) -> Result[Int, IoError] {
    return case dat error {
        IoError.EndOfStream => Result[Int, IoError].Err(IoError.EndOfStream),
        IoError.Failed => Result[Int, IoError].Err(IoError.Failed),
        IoError.InvalidInput => Result[Int, IoError].Err(IoError.InvalidInput),
        IoError.InvalidData => Result[Int, IoError].Err(IoError.InvalidData),
        IoError.Unsupported => Result[Int, IoError].Err(IoError.Unsupported),
        IoError.PermissionDenied => Result[Int, IoError].Err(IoError.PermissionDenied),
        IoError.Busy => Result[Int, IoError].Err(IoError.Busy),
        IoError.CrossDevice => Result[Int, IoError].Err(IoError.CrossDevice),
        IoError.AlreadyExists => Result[Int, IoError].Err(IoError.AlreadyExists),
    };
}

"""Finish a copy after one reader result.

`error` is consumed as `dat`. `EndOfStream` is normal completion and returns
the accumulated `total` as `Ok`; all other variants remain typed `Err` values.
No reader or buffer ownership is retained.
"""
open verb copy_read_error(dat error: IoError, erg total: Int) -> Result[Int, IoError] {
    return case dat error {
        IoError.EndOfStream => Result[Int, IoError].Ok(total),
        IoError.Failed => Result[Int, IoError].Err(IoError.Failed),
        IoError.InvalidInput => Result[Int, IoError].Err(IoError.InvalidInput),
        IoError.InvalidData => Result[Int, IoError].Err(IoError.InvalidData),
        IoError.Unsupported => Result[Int, IoError].Err(IoError.Unsupported),
        IoError.PermissionDenied => Result[Int, IoError].Err(IoError.PermissionDenied),
        IoError.Busy => Result[Int, IoError].Err(IoError.Busy),
        IoError.CrossDevice => Result[Int, IoError].Err(IoError.CrossDevice),
        IoError.AlreadyExists => Result[Int, IoError].Err(IoError.AlreadyExists),
    };
}

"""Validate one completed writer chunk and calculate the next total.

The `erg` counts are scalar working values. `Ok(total + actual)` is returned
only when the writer consumed exactly `expected` bytes; a short or inconsistent
write returns `Err(IoError.Failed)`. No stream or allocation is retained.
"""
open verb copy_written_chunk(erg total: Int, erg expected: Int, erg actual: Int) -> Result[Int, IoError] {
    erg difference = actual - expected;
    return case difference {
        0 => Result[Int, IoError].Ok(total + actual),
        _ => Result[Int, IoError].Err(IoError.Failed),
    };
}

"""Allocate the bounded reusable buffer used by `copy_stream`.

The returned `Buffer` is newly owned on `Ok`. Allocation is fixed at 4096
bytes and occurs once per copy operation; failure drops partial storage before
returning `Err(IoError.Failed)`. This helper performs no stream I/O.
"""
open verb copy_scratch() -> Result[Buffer, IoError] {
    erg scratch = Buffer[0];
    erg capacity = 4096;
    erg reserved = actus_copy_buffer_reserve(buffer: ins scratch, capacity: capacity);
    if reserved == -1 {
        drop(scratch);
        return Result[Buffer, IoError].Err(IoError.Failed);
    }
    return Result[Buffer, IoError].Ok(scratch);
}

"""Write one scratch-buffer chunk and return the next byte total.

`writer` is an exclusive `ins` loan restored after the call; `scratch` is an
immutable `abs` view owned by `copy_stream`. A complete write returns the new
count, a short write returns `IoError.Failed`, and writer errors are preserved
without allocation or retained state.
"""
open verb copy_stream_write[W: Writer](
    ins writer: W,
    abs scratch: Buffer,
    erg expected: Int,
    erg total: Int
) -> Result[Int, IoError] {
    erg write_result: Result[Int, IoError] = writer.write(buffer: abs scratch);
    return case dat write_result {
        Result.Ok(written) => copy_written_chunk(
            total: total,
            expected: expected,
            actual: written
        ),
        Result.Err(error) => copy_write_error(error: dat error),
    };
}

"""Copy a bounded stream from `reader` to `writer`.

Both participants are exclusive `ins` loans restored after each call. The
operation allocates one fixed 4096-byte scratch buffer, reuses it for every
chunk, and drops it on every return path. `Ok(count)` is the exact total after
normal `EndOfStream`; short writes, invalid zero-length chunks, allocation
failures, and typed reader/writer failures return `Err`. No entire input is
loaded or retained in memory.
"""
open verb copy_stream[R: Reader, W: Writer](ins reader: R, ins writer: W) -> Result[Int, IoError] {
    erg scratch = copy_scratch()?;
    erg total = 0;
    loop {
        erg read_result: Result[Int, IoError] = reader.read(buffer: ins scratch);
        case dat read_result {
            Result.Ok(count) => case count {
                0 => {
                    return Result[Int, IoError].Err(IoError.InvalidData);
                },
                _ => {
                    total = copy_stream_write(
                        writer: ins writer,
                        scratch: abs scratch,
                        expected: count,
                        total: total
                    )?;
                },
            },
            Result.Err(error) => {
                return copy_read_error(error: dat error, total: total);
            },
        };
    }
    return Result[Int, IoError].Ok(total);
}
