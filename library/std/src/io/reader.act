"""
The static read contract used by buffered input adapters.

`Self` identifies the concrete source selected during monomorphization;
`ins buffer` is the caller-owned destination filled without allocation.
"""
open role Reader {
    """Read through ins receiver and buffer loans, returning count or typed error."""
    meta effect("filesystem", "blocking")
    verb read(ins self: Self, ins buffer: Buffer) -> Result[Int, IoError];
}
