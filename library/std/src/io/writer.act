"""
The static write contract used by buffered output adapters.

The concrete `Self` target is selected statically. The `ins` receiver owns
the mutable stream state; source bytes are an `abs` view.
"""
open role Writer {
    """Write a borrowed view without taking ownership of its bytes."""
    verb write(ins self: Self, abs buffer: Buffer) -> Result[Int, IoError];
    """Synchronize pending output and report a typed status."""
    verb flush(ins self: Self) -> Result[Int, IoError];
}
