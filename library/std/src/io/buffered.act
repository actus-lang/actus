/// A caller-owned input buffer used by buffered read operations.
///
/// The `erg` field owns the reusable storage. Refill operations borrow the
/// reader with `ins`, so the storage is filled in place without allocation.
open struct BufferedReader {
    erg buffer: Buffer,
}

/// A caller-owned output buffer used by buffered write operations.
///
/// The `erg` field owns the reusable storage. Output operations borrow that
/// storage with `ins`, append `abs` source bytes, and never allocate after the
/// caller has reserved the required capacity.
open struct BufferedWriter {
    erg buffer: Buffer,
}

/// Construct a buffered reader from an owned reusable buffer.
///
/// `dat buffer` transfers ownership into the reader. The returned reader is
/// responsible for the buffer's eventual cleanup.
open verb buffered_reader(dat buffer: Buffer) -> BufferedReader {
    return BufferedReader { buffer: buffer, };
}

/// Construct a buffered writer from an owned reusable buffer.
///
/// `dat buffer` transfers ownership into the writer. No second allocation is
/// performed by the constructor.
open verb buffered_writer(dat buffer: Buffer) -> BufferedWriter {
    return BufferedWriter { buffer: buffer, };
}

/// Refill a reader's existing buffer from stdin until newline or EOF.
///
/// The `ins reader` loan is non-escaping and covers the complete call. The
/// result reports the exact byte count or a typed I/O error.
open verb refill(ins reader: BufferedReader) -> Result[Int, IoError] {
    return read_line(buffer: ins reader.buffer);
}

open unsafe extern "C" verb actus_buffer_reserve(
    ins buffer: Buffer,
    erg capacity: Int
) -> Int;

open unsafe extern "C" verb actus_buffered_write_stdout(
    ins buffer: Buffer,
    abs input: Buffer
) -> Int;

open unsafe extern "C" verb actus_flush_buffered_stdout(ins buffer: Buffer) -> Int;

/// Reserve reusable storage for a buffered writer.
///
/// The buffer length is preserved; only its backing capacity is increased.
open verb reserve(ins buffer: Buffer, erg capacity: Int) -> Result[Int, IoError] {
    erg status = actus_buffer_reserve(buffer: ins buffer, capacity: capacity);
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}

/// Append an immutable source to a reusable stdout buffer.
///
/// Full storage is written automatically. `Result.Ok(count)` reports the
/// number of source bytes accepted, while `Err(Failed)` reports a reserve or
/// output failure. The source remains available because it is borrowed with
/// `abs`; the destination is exclusively borrowed with `ins`.
open verb buffered_write(
    ins buffer: Buffer,
    abs input: Buffer
) -> Result[Int, IoError] {
    erg status = actus_buffered_write_stdout(buffer: ins buffer, input: abs input);
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}

/// Write the pending bytes and reset the reusable stdout buffer.
///
/// `Result.Ok(count)` is the number of bytes flushed. The backing storage is
/// retained for the next write, so repeated flush cycles do not allocate.
open verb flush_buffer(ins buffer: Buffer) -> Result[Int, IoError] {
    erg status = actus_flush_buffered_stdout(buffer: ins buffer);
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}
