"""
A reusable input adapter over a statically selected `Reader` source.

Both the source and storage are owned by the adapter. Refill borrows the
adapter for one call and fills the existing storage without allocation.
"""
open struct BufferedReader[Source: Reader] {
    """Concrete stream selected by static dispatch and owned by the adapter."""
    erg source: Source,
    """Owned erg reusable storage filled by `refill`; it is never returned by the source."""
    erg buffer: Buffer,
}

"""
A reusable output adapter over a statically selected `Writer` target.

The target and storage are owned by the adapter. Output operations borrow
the adapter with `ins` and pass source bytes as `abs` views.
"""
open struct BufferedWriter[Target: Writer] {
    """Concrete destination selected by static dispatch and owned by the adapter."""
    erg target: Target,
    """Fixed-capacity pending output; its bytes are borrowed into `Target.write`."""
    erg buffer: Buffer,
}

"""
Construct a buffered reader from an owned source and reusable buffer.

Both `dat` arguments transfer ownership into the reader, which performs
deterministic cleanup for the source and buffer and returns the new reader.
"""
open verb buffered_reader[Source: Reader](dat source: Source, dat buffer: Buffer) -> BufferedReader[Source] {
    return BufferedReader[Source] { source: source, buffer: buffer, };
}

"""
Construct a buffered writer from an owned target and reusable buffer.

Both `dat` arguments transfer ownership into the writer. No second
allocation is performed by the constructor, which returns the new writer.
"""
open verb buffered_writer[Target: Writer](dat target: Target, dat buffer: Buffer) -> BufferedWriter[Target] {
    return BufferedWriter[Target] { target: target, buffer: buffer, };
}

"""
Refill a reader's existing buffer from its statically selected source.

The `ins reader` loan is non-escaping and covers the complete call. The
result reports the exact byte count or a typed I/O error.
"""
open verb refill[Source: Reader](ins reader: BufferedReader[Source]) -> Result[Int, IoError] {
    return reader.source.read(buffer: ins reader.buffer);
}

"""
Reserve at least `capacity` bytes for `buffer` without changing its logical
length. The `ins` buffer remains owned by the caller; zero is returned only
for invalid input and `-1` reports allocation failure at the native boundary.
"""
open unsafe extern "C" verb actus_buffer_reserve(
    ins buffer: Buffer,
    erg capacity: Int
) -> Int;

"""Return reserved capacity through the C ABI, or `-1` for an invalid buffer handle."""
open unsafe extern "C" verb actus_buffer_capacity(abs buffer: Buffer) -> Int;

"""Return logical byte length through the C ABI, or `-1` for an invalid buffer handle."""
open unsafe extern "C" verb actus_buffer_length(abs buffer: Buffer) -> Int;

"""
Append at most `length` bytes beginning at `offset` from the borrowed source.
The `ins` target is never reallocated; the return value is the exact appended
count from the C ABI, zero means full capacity, and `-1` means invalid handles or bounds.
"""
open unsafe extern "C" verb actus_buffer_append_range(
    ins target: Buffer,
    abs source: Buffer,
    erg offset: Int,
    erg length: Int
) -> Int;

"""Clear an ins buffer's logical length through the C ABI while retaining capacity; return cleared byte count or `-1`."""
open unsafe extern "C" verb actus_buffer_clear(ins buffer: Buffer) -> Int;

"""
Reserve reusable storage for a buffered writer.

The buffer length is preserved; only its backing capacity is increased.
The verb returns the resulting capacity or a typed failure.
"""
open verb reserve(ins buffer: Buffer, erg capacity: Int) -> Result[Int, IoError] {
    erg status = actus_buffer_reserve(buffer: ins buffer, capacity: capacity);
    return case status {
        -1 => Result[Int, IoError].Err(IoError.Failed),
        _ => Result[Int, IoError].Ok(status),
    };
}

"""
Write an immutable source through the selected writer target.

The adapter first appends bytes to its fixed-capacity internal buffer. When
that buffer becomes full, it is flushed through the selected target before
more source bytes are accepted. The target is never called for a partial
buffer merely because this verb returns; typed errors are propagated to the caller.
"""
open verb buffered_write[Target: Writer](
    ins writer: BufferedWriter[Target],
    abs input: Buffer
) -> Result[Int, IoError] {
    erg source_length = actus_buffer_length(buffer: abs input);
    erg total = 0;
    loop {
        erg remaining = source_length - total;
        case remaining {
            0 => { return Result[Int, IoError].Ok(total); },
            _ => { },
        };
        erg accepted = actus_buffer_append_range(
            target: ins writer.buffer,
            source: abs input,
            offset: total,
            length: remaining
        );
        case accepted {
            -1 => { return Result[Int, IoError].Err(IoError.Failed); },
            0 => { return Result[Int, IoError].Err(IoError.InvalidData); },
            _ => { },
        };
        total = total + accepted;
        erg capacity = actus_buffer_capacity(buffer: abs writer.buffer);
        erg buffered = actus_buffer_length(buffer: abs writer.buffer);
        case capacity {
            -1 => { return Result[Int, IoError].Err(IoError.Failed); },
            _ => { },
        };
        case buffered {
            -1 => { return Result[Int, IoError].Err(IoError.Failed); },
            _ => { },
        };
        erg remaining_capacity = buffered - capacity;
        case remaining_capacity {
            0 => {
                flush_buffer(writer: ins writer)?;
            },
            _ => { },
        };
    }
    return Result[Int, IoError].Ok(total);
}

"""
Flush the pending bytes through the selected writer target.

`Result.Ok(count)` is the number of bytes accepted by the target. A
successful flush clears only the logical length; the backing allocation is
retained for the next write.
"""
open verb flush_buffer[Target: Writer](ins writer: BufferedWriter[Target]) -> Result[Int, IoError] {
    erg pending = actus_buffer_length(buffer: abs writer.buffer);
    case pending {
        -1 => { return Result[Int, IoError].Err(IoError.Failed); },
        _ => { },
    };
    erg result = writer.target.write(buffer: abs writer.buffer);
    return case dat result {
        Result.Ok(count) => {
            actus_buffer_clear(buffer: ins writer.buffer);
            writer.target.flush()?;
            return Result[Int, IoError].Ok(count);
        },
        Result.Err(error) => Result[Int, IoError].Err(error),
    };
}
