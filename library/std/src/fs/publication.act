"""Staged filesystem writes and explicit atomic publication operations."""
import {
    io,
    path as path_module,
};

"""
Create or truncate `path`, write the complete borrowed contents, flush, and
close the file before returning.

`path` and `contents` are immutable `abs` views; neither is transferred,
retained, or replaced. The operation creates one owned `File` internally and
closes it on every success and failure branch. `Ok(count)` is the exact byte
count and is returned only after the count equals the complete input length
and flush succeeds. A short write, open failure, flush failure, close failure,
or end-of-stream condition becomes a typed `IoError`; no partial success is
reported and no hidden result buffer is allocated.
"""
open verb write_file(abs path: path_module::Path, abs contents: Buffer) -> Result[Int, io::IoError] {
    return write_and_flush(path: abs path, contents: abs contents);
}

"""
Write a complete file through a staging path and publish it with one rename.

`path` and `contents` are immutable `abs` views. `staging` is transferred with
`dat`, must be on the same filesystem as the final destination, and is never
returned after this operation. The contents are fully written, length-checked,
flushed, and closed before the rename is attempted. Only a successful rename
publishes the staged bytes; write, short-write, flush, close, or rename failure
returns the original typed error and invokes deterministic best-effort staging
cleanup. The final destination is not exposed to partially written staged
contents, and the operation performs no hidden result-buffer allocation.
"""
open verb write_file_atomic(
    abs path: path_module::Path,
    dat staging: path_module::Path,
    abs contents: Buffer
) -> Result[Int, io::IoError] {
    erg written = write_and_flush(path: abs staging, contents: abs contents);
    return case dat written {
        Result.Err(error) => cleanup_atomic_failure(staging: dat staging, error: dat error),
        Result.Ok(count) => {
            erg published = rename(from: abs staging, to: abs path);
            return case dat published {
                Result.Ok(_) => {
                    drop(staging);
                    return Result[Int, io::IoError].Ok(count);
                },
                Result.Err(error) => cleanup_atomic_failure(staging: dat staging, error: dat error),
            };
        },
    };
}

"""
Create or truncate a file, write all borrowed bytes, flush, and close it.

`path` and `contents` are immutable `abs` views used only for the operation;
the created `File` is an internal owner and never escapes. The function checks
the native count against the complete input length, rejects short writes,
flushes before reporting success, and closes the handle on every branch.
`Ok(count)` is therefore a complete committed-to-the-provider write, while
`Err(IoError)` reports open, write, size, flush, or close failure. No staging
path, replacement buffer, or hidden allocation is introduced here.
"""
open verb write_and_flush(abs path: path_module::Path, abs contents: Buffer) -> Result[Int, io::IoError] {
    erg opened = file_create(path: abs path);
    return case dat opened {
        Result.Err(error) => Result[Int, io::IoError].Err(error),
        Result.Ok(value) => {
            erg file: File = value;
            erg written = file.write(buffer: abs contents);
            return case dat written {
                Result.Err(error) => {
                    erg closed_on_write_error = file_close(self: ins file);
                    return Result[Int, io::IoError].Err(error);
                },
                Result.Ok(count) => {
                    erg expected_result = io::buffer_size(buffer: abs contents);
                    return case dat expected_result {
                        Result.Err(error) => {
                            erg closed_on_size_error = file_close(self: ins file);
                            return Result[Int, io::IoError].Err(error);
                        },
                        Result.Ok(expected) => {
                            if count != expected {
                                erg closed_on_size_mismatch = file_close(self: ins file);
                                return Result[Int, io::IoError].Err(io::IoError.Failed);
                            }
                            erg flushed = file.flush();
                            return case dat flushed {
                                Result.Ok(_) => {
                                    erg closed_after_flush = file_close(self: ins file);
                                    return case dat closed_after_flush {
                                        Result.Ok(_) => Result[Int, io::IoError].Ok(count),
                                        Result.Err(error) => Result[Int, io::IoError].Err(error),
                                    };
                                },
                                Result.Err(error) => {
                                    erg closed_on_flush_error = file_close(self: ins file);
                                    return Result[Int, io::IoError].Err(error);
                                },
                            };
                        },
                    };
                },
            };
        },
    };
}

"""
Clean up failed atomic-publication staging storage and preserve the root error.

`staging` and `error` are consumed with `dat`; the staging path is removed on
a best-effort basis and then released, while the original write, flush, or
rename error is returned unchanged. Cleanup failure is intentionally not
substituted for the root failure, and this helper performs no retry, final
destination mutation, or hidden allocation.
"""
open verb cleanup_atomic_failure(
    dat staging: path_module::Path,
    dat error: io::IoError
) -> Result[Int, io::IoError] {
    remove_file(path: abs staging);
    drop(staging);
    return Result[Int, io::IoError].Err(error);
}
