"""
Streaming directory access through one owned host directory handle.

The iterator returns one owned `DirectoryEntry` at a time. It does not retain the
parent path, expose a native pointer, or allocate an unbounded entry array.
"""
import {
    io,
    path as path_module,
};

"""Maximum raw storage reserved for one returned directory entry name."""
open const DIRECTORY_ENTRY_BUFFER_BYTES: Int = 4096;

"""An owned opaque directory handle backed by one host directory resource."""
open struct Directory {
    """Owned erg scalar token for one host directory; Drop provides best-effort scope cleanup."""
    erg handle: Int,
}

"""
Classifies one streamed directory entry without exposing host-specific type
bits or retaining a native directory pointer. `File`, `Directory`, and
`Symlink` are provider observations; `Other` covers entries that do not have
one of those stable portable classifications. The enum is a copied scalar
fact owned by its containing `DirectoryEntry` value and requires no cleanup.
"""
open enum DirectoryEntryKind {
    """The provider identified the entry as a regular file."""
    File,
    """The provider identified the entry as a directory."""
    Directory,
    """The provider identified the entry as a symbolic link."""
    Symlink,
    """The provider reported another, special, or unsupported entry kind."""
    Other,
}

"""
Owned facts for one directory entry.

`name` is the entry name returned by the provider. `relative_path` is the
owned path component used by the directory consumer. `kind` and `metadata`
are copied provider facts. Every path field owns its `Buffer`; the value does
not retain the parent `Directory`, a native directory handle, or a borrowed
host pointer. Dropping this value releases only its owned path storage.
"""
open struct DirectoryEntry {
    """Owned path storage for the provider-reported entry name."""
    erg name: path_module::Path,
    """Owned path storage for the entry's relative consumer path."""
    erg relative_path: path_module::Path,
    """Owned copied classification; no native pointer or directory handle is retained."""
    erg kind: DirectoryEntryKind,
    """Owned copied metadata facts; they require no native handle cleanup."""
    erg metadata: Metadata,
}

"""
Open one directory for streaming enumeration.

`path` is borrowed only for the runtime call. The returned `Directory` owns
the host handle and does not retain the source path.
"""
unsafe extern "C" verb actus_directory_open(abs path: path_module::Path) -> Int;

"""
Write the next entry name into caller-owned storage.

The bridge returns zero for POSIX path storage, one for Windows UTF-16 path
storage, `-1` for failure, `-2` for normal end of directory, and `-3` when
the fixed destination storage is too small.
"""
unsafe extern "C" verb actus_directory_next(abs handle: Int, ins storage: Buffer) -> Int;

"""
Write the next entry name and a copied metadata snapshot into caller-owned
storage. The runtime uses link metadata, so a symbolic link is classified as
`Symlink` even when its target is missing or has another type.
"""
unsafe extern "C" verb actus_directory_next_entry(
    abs handle: Int,
    ins storage: Buffer,
    ins metadata: Metadata
) -> Int;

"""Read one initialized byte from entry storage without transferring ownership."""
unsafe extern "C" verb actus_buffer_byte_at(abs storage: Buffer, erg index: Int) -> Int;

"""Close one owned directory handle exactly once through the runtime bridge."""
unsafe extern "C" verb actus_directory_close(abs handle: Int) -> Int;

"""
Open a directory and return a handle owned by the resulting `Directory`.

Inputs: `path` is an `abs` path view and is borrowed, not consumed. Returns:
`Ok(Directory)` owns the host handle; `Err(IoError.Failed)` reports a missing,
invalid, or inaccessible directory. Errors leave no live handle exposed.
The operation performs no unbounded allocation; callers may release the
resource explicitly with `close_dir`, while Drop provides best-effort cleanup
on scope exit.
"""
open verb read_dir(abs path: path_module::Path) -> Result[Directory, io::IoError] {
    erg handle = actus_directory_open(path: abs path);
    erg failed: Bool = handle == -1;
    return case failed {
        true => {
            erg rejected = Directory {
                handle: handle,
            };
            drop(rejected);
            Err(io::IoError.Failed);
        },
        _ => Ok(Directory {
            handle: handle,
        }),
    };
}

"""
Classify and return the next entry as an owned `DirectoryEntry`.

`Ok(None)` is normal end-of-directory. Each successful call allocates only
the two owned path values and the copied scalar metadata; the iterator itself
remains bounded by one host handle and the fixed entry-name buffer. Metadata
describes the directory entry itself rather than following a symbolic link.
Errors are returned as typed `IoError` values and leave the directory owner
available for explicit close.
"""
open verb next_dir_entry(ins directory: Directory) -> Result[Option[DirectoryEntry], io::IoError] {
    erg storage: Buffer = Buffer[4096];
    erg metadata = Metadata {
        size: 0,
        is_file: 0,
        is_dir: 0,
        readonly: 0,
        is_symlink: 0,
    };
    erg status = actus_directory_next_entry(
        handle: abs directory.handle,
        storage: ins storage,
        metadata: ins metadata
    );
    return case status {
        -1 => {
            drop(storage);
            drop(metadata);
            Err(io::IoError.Failed);
        },
        -2 => {
            drop(storage);
            drop(metadata);
            Ok(Option[DirectoryEntry].None);
        },
        -3 => {
            drop(storage);
            drop(metadata);
            Err(io::IoError.InvalidInput);
        },
        0 => {
            return directory_entry_from_storage(
                storage: dat storage,
                metadata: dat metadata,
                status: status
            );
        },
        1 => {
            return directory_entry_from_storage(
                storage: dat storage,
                metadata: dat metadata,
                status: status
            );
        },
        _ => {
            drop(storage);
            drop(metadata);
            Err(io::IoError.Failed);
        },
    };
}

verb copy_entry_storage(abs source: Buffer) -> Result[Buffer, io::IoError] {
    erg output: Buffer = Buffer[0];
    erg length = io::buffer_size(buffer: abs source)?;
    erg index: Int = 0;
    loop {
        if index >= length {
            break;
        }
        erg byte = actus_buffer_byte_at(storage: abs source, index: erg index);
        append(output, byte as u8);
        index += 1;
    }
    return Ok(output);
}

verb directory_entry_kind(abs metadata: Metadata) -> DirectoryEntryKind {
    return case metadata.is_symlink {
        1 => DirectoryEntryKind.Symlink,
        _ => case metadata.is_file {
            1 => DirectoryEntryKind.File,
            _ => case metadata.is_dir {
                1 => DirectoryEntryKind.Directory,
                _ => DirectoryEntryKind.Other,
            },
        },
    };
}

verb directory_path_result(dat result: Result[path_module::Path, path_module::PathError]) -> Result[path_module::Path, io::IoError] {
    return case dat result {
        Result.Err(_) => Err(io::IoError.InvalidData),
        Result.Ok(value) => Ok(value),
    };
}

verb directory_entry_from_storage(
    dat storage: Buffer,
    dat metadata: Metadata,
    erg status: Int
) -> Result[Option[DirectoryEntry], io::IoError] {
    erg relative_storage = copy_entry_storage(source: abs storage)?;
    erg name_result = case status {
        0 => path_module::path_from_posix(storage: dat storage),
        _ => path_module::path_from_windows_utf16(storage: dat storage),
    };
    erg name = directory_path_result(result: dat name_result)?;
    erg relative_result = case status {
        0 => path_module::path_from_posix(storage: dat relative_storage),
        _ => path_module::path_from_windows_utf16(storage: dat relative_storage),
    };
    erg relative_path = directory_path_result(result: dat relative_result)?;
    erg kind = directory_entry_kind(metadata: abs metadata);
    return Ok(Option[DirectoryEntry].Some(DirectoryEntry {
        name: name,
        relative_path: relative_path,
        kind: kind,
        metadata: metadata,
    }));
}

"""
Close an exclusively borrowed directory and mark its owned handle closed.

The input directory is borrowed through `ins`, not copied or consumed.
Returns `Ok(0)` on successful release or `Err(IoError.Failed)` when the host
handle is already invalid or cannot be released. No allocation is performed.
"""
open verb close_dir(ins directory: Directory) -> Result[Int, io::IoError] {
    erg status = actus_directory_close(handle: abs directory.handle);
    return case status {
        -1 => Err(io::IoError.Failed),
        _ => {
            directory.handle = -1;
            Ok(status);
        },
    };
}

"""Close a live directory handle during deterministic scope cleanup."""
open perform Drop for Directory {
    """Close the owned Directory resource through an ins loan during best-effort early return, branch exit, and implicit scope cleanup."""
    verb drop(ins self: Directory) {
        close_dir(directory: ins self);
    }
}
