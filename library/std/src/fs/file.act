"""
A hosted file handle owned by the enclosing Actus binding.

The handle is an opaque runtime token. File construction returns a typed
Result, and the Drop performance closes the underlying operating-system
resource exactly once when ownership leaves scope.
"""
import io;
import path;
"""
An owned opaque file handle backed by one host operating-system resource.
The erg handle is closed by its Drop performance and never stores a Path.
"""
open struct File {
    """Opaque host handle. Only runtime bridge verbs may interpret it."""
    erg handle: Int,
}

"""
Open a path using the runtime's read mode. `path` is an `abs` view and is
not retained or copied. The bridge performs no path allocation. The result is
a new owned `File`, or `-1` on native failure; the facade maps failure to
`IoError.Failed`.
"""
open unsafe extern "C" verb actus_file_open_path(abs path: Path, abs mode: Int) -> Int;

"""
Read into the existing `ins` buffer. Non-negative values are byte counts;
`-1` is `Failed` and `-2` is `EndOfStream`. The runtime retains no buffer.
"""
open unsafe extern "C" verb actus_file_read_buffer(abs handle: Int, ins buffer: Buffer) -> Int;

"""
Write the logical bytes of an `abs` buffer. Non-negative values are byte
counts; `-1` is `Failed` and `-2` is `EndOfStream`.
"""
"""The C ABI returns a byte count, `-1` for failure, or `-2` for EOF."""
open unsafe extern "C" verb actus_file_write_buffer(abs handle: Int, abs buffer: Buffer) -> Int;

"""Flush an owned handle through the C ABI; zero is success and `-1` is `Failed`."""
open unsafe extern "C" verb actus_file_flush_buffer(abs handle: Int) -> Int;

"""Close an owned handle exactly once through the C ABI; zero is success and `-1` is failure."""
open unsafe extern "C" verb actus_file_close_buffer(abs handle: Int) -> Int;

"""Move a file cursor through the C ABI and return its resulting absolute byte position or failure."""
open unsafe extern "C" verb actus_file_seek_buffer(
    abs handle: Int,
    abs offset: Int,
    abs whence: Int
) -> Int;

"""Consume an invalid scalar handle and return it so constructor branches join cleanly."""
open verb discard_handle(dat handle: Int) -> Int { return handle; }

"""
Open an existing filesystem path for reading.

`path` is an `abs` view borrowed only for the runtime call; it is not stored
in the returned resource. `Ok(File)` transfers ownership of the new host
handle to the caller, while `Err(IoError.Failed)` reports that the path could
not be opened. The `File` Drop performance closes a successful handle once.
"""
open verb file_open(abs path: Path) -> Result[File, IoError] {
    erg mode = 0;
    erg handle = actus_file_open_path(path: abs path, mode: abs mode);
    return case handle {
        -1 => { discard_handle(handle: dat handle); return Err(IoError.Failed); },
        _ => Ok(File { handle: handle, }),
    };
}

"""
Create or truncate a filesystem path for writing.

`path` is an `abs` view borrowed only for the runtime call. `Ok(File)` gives
the caller ownership of the new host handle; `Err(IoError.Failed)` means the
host rejected creation or truncation. No path buffer is retained by `File`.
"""
open verb file_create(abs path: Path) -> Result[File, IoError] {
    erg mode = 1;
    erg handle = actus_file_open_path(path: abs path, mode: abs mode);
    return case handle {
        -1 => { discard_handle(handle: dat handle); return Err(IoError.Failed); },
        _ => Ok(File { handle: handle, }),
    };
}

"""Read file bytes into caller-provided storage without allocating per call."""
open perform Reader for File {
    """Read through ins loans, mutate caller storage, and return count or typed error."""
    verb read(ins self: File, ins buffer: Buffer) -> Result[Int, IoError] {
        erg status = actus_file_read_buffer(handle: abs self.handle, buffer: ins buffer);
        return case status {
            -1 => Err(IoError.Failed),
            -2 => Err(IoError.EndOfStream),
            _ => Ok(status),
        };
    }
}

"""Write borrowed bytes and flush a file through the Writer contract."""
open perform Writer for File {
    """
    Write an `abs` byte view through an `ins` file loan. No input buffer is
    allocated or retained. `Result.Ok(count)` is the exact byte count;
    `Err` reports the typed I/O failure.
    """
    verb write(ins self: File, abs buffer: Buffer) -> Result[Int, IoError] {
        erg status = actus_file_write_buffer(handle: abs self.handle, buffer: abs buffer);
        return case status {
            -1 => Err(IoError.Failed),
            -2 => Err(IoError.EndOfStream),
            _ => Ok(status),
        };
    }

    """Flush through an ins file loan and return zero or typed failure."""
    verb flush(ins self: File) -> Result[Int, IoError] {
        erg status = actus_file_flush_buffer(handle: abs self.handle);
        return case status {
            -1 => Err(IoError.Failed),
            _ => Ok(status),
        };
    }
}

"""Translate a runtime cursor position into a typed result."""
open verb file_seek_status(erg status: Int) -> Result[Int, IoError] {
    return case status {
        -1 => Err(IoError.Failed),
        _ => Ok(status),
    };
}

"""
Seek through the `ins` file loan from the beginning. The file position is
mutated in the runtime without allocating a buffer. `Ok(position)` returns the
new position; `Err(IoError.Failed)` reports rejection.
"""
open verb file_seek_start(ins self: File, abs offset: Int) -> Result[Int, IoError] {
    erg origin = 0;
    erg status = actus_file_seek_buffer(
        handle: abs self.handle,
        offset: abs offset,
        whence: abs origin
    );
    return file_seek_status(status: status);
}

"""
Seek through the `ins` file loan relative to its current position. The
position mutation is allocation-free. `Ok(position)` returns the new position;
`Err(IoError.Failed)` reports runtime rejection.
"""
open verb file_seek_current(ins self: File, abs offset: Int) -> Result[Int, IoError] {
    erg origin = 1;
    erg status = actus_file_seek_buffer(
        handle: abs self.handle,
        offset: abs offset,
        whence: abs origin
    );
    return file_seek_status(status: status);
}

"""
Seek through the `ins` file loan relative to the end of the file. The runtime
mutates only the cursor position and allocates no buffer. `Ok(position)` is the
new position; `Err(IoError.Failed)` reports rejection.
"""
open verb file_seek_end(ins self: File, abs offset: Int) -> Result[Int, IoError] {
    erg origin = 2;
    erg status = actus_file_seek_buffer(
        handle: abs self.handle,
        offset: abs offset,
        whence: abs origin
    );
    return file_seek_status(status: status);
}

"""Satisfy the positional stream contract through the host runtime."""
open perform Seeker for File {
    """Seek through an ins file loan and dat cursor origin, returning a position or error."""
    verb seek(ins self: File, dat from: SeekFrom) -> Result[Int, IoError] {
        return case dat from {
            SeekFrom.Start(offset) => file_seek_start(self: ins self, offset: abs offset),
            SeekFrom.Current(offset) => file_seek_current(self: ins self, offset: abs offset),
            SeekFrom.End(offset) => file_seek_end(self: ins self, offset: abs offset),
        };
    }
}

"""Return metadata for this open file without transferring its handle, or typed failure."""
open verb file_metadata_failed(dat output: Metadata) -> Result[Metadata, IoError] {
    drop(output);
    return Result[Metadata, IoError].Err(IoError.Failed);
}

"""Provide metadata through an ins file loan and return scalar facts or error."""
open perform MetadataProvider for File {
    """Inspect metadata through an ins file loan and return scalar facts or failure."""
    verb metadata(ins self: File) -> Result[Metadata, IoError] {
        erg output = Metadata { size: 0, is_file: 0, is_dir: 0, readonly: 0, };
        erg status = actus_file_metadata_handle_buffer(
            handle: abs self.handle,
            output: ins output
        );
        return case status {
            -1 => file_metadata_failed(output: dat output),
            _ => Result[Metadata, IoError].Ok(output),
        };
    }
}

"""Close the owned operating-system resource during deterministic LIFO cleanup."""
open perform Drop for File {
    """Close the owned File resource through an ins loan during deterministic cleanup."""
    verb drop(ins self: File) {
        actus_file_close_buffer(handle: abs self.handle);
    }
}
