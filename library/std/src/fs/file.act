"""
A hosted file handle owned by the enclosing Actus binding.

The handle is an opaque runtime token. File construction returns a typed
Result, and the Drop performance closes the underlying operating-system
resource exactly once when ownership leaves scope.
"""
import {
    io,
    path as path_module,
};

"""
An owned opaque file handle backed by one host operating-system resource.
The erg handle is closed by its Drop performance and never stores a Path.
"""
open struct File {
    """Opaque host handle. Only runtime bridge verbs may interpret it."""
    erg handle: Int,
}

"""
Open a path using the runtime's read mode. `path` is an `abs` view and is
not retained or copied. The bridge performs no path allocation. The result is
a new owned `File`, or `-1` on native failure; the facade maps failure to
`IoError.Failed`.
"""
unsafe extern "C" verb actus_file_open_path(
    abs path: path_module::Path,
    abs mode: Int
) -> Int;

"""
Read into the existing `ins` buffer. Non-negative values are byte counts;
`-1` is `Failed` and `-2` is `EndOfStream`. The runtime retains no buffer.
"""
unsafe extern "C" verb actus_file_read_buffer(abs handle: Int, ins buffer: Buffer) -> Int;

"""
Write the logical bytes of an `abs` buffer. Non-negative values are byte
counts; `-1` is `Failed` and `-2` is `EndOfStream`.
"""
"""The C ABI returns a byte count, `-1` for failure, or `-2` for EOF."""
unsafe extern "C" verb actus_file_write_buffer(
    abs handle: Int,
    abs buffer: Buffer
) -> Int;

"""Flush an owned handle through the C ABI; zero is success and `-1` is `Failed`."""
unsafe extern "C" verb actus_file_flush_buffer(abs handle: Int) -> Int;

"""Synchronize file contents through the hosted filesystem ABI."""
unsafe extern "C" verb actus_file_sync_data_buffer(abs handle: Int) -> Int;

"""Synchronize file contents and metadata through the hosted filesystem ABI."""
unsafe extern "C" verb actus_file_sync_all_buffer(abs handle: Int) -> Int;

"""Close an owned handle exactly once through the C ABI; zero is success and `-1` is failure."""
unsafe extern "C" verb actus_file_close_buffer(abs handle: Int) -> Int;

"""Move a file cursor through the C ABI and return its resulting absolute byte position or failure."""
unsafe extern "C" verb actus_file_seek_buffer(
    abs handle: Int,
    abs offset: Int,
    abs whence: Int
) -> Int;

"""
Consume a rejected native handle without exposing it as a live `File`.

`handle` is transferred with `dat` and returned as the same scalar so failure
branches can join the constructor's typed `Result` path. No filesystem call,
allocation, or retry is performed; callers use this only for an invalid
runtime status and must not interpret the returned value as an open handle.
"""
open verb discard_handle(dat handle: Int) -> Int {
    return handle;
}

"""
Open an existing filesystem path for reading.

`path` is an `abs` view borrowed only for the runtime call; it is not stored
in the returned resource. `Ok(File)` transfers ownership of the new host
handle to the caller, while `Err(IoError.Failed)` reports that the path could
not be opened. The `File` Drop performance closes a successful handle once.
"""
open verb file_open(abs path: path_module::Path) -> Result[File, io::IoError] {
    erg mode = 0;
    erg handle = actus_file_open_path(path: abs path, mode: abs mode);
    return case handle {
        -1 => {
            discard_handle(handle: dat handle);
            return Err(io::IoError.Failed);
        },
        _ => Ok(File {
            handle: handle,
        }),
    };
}

"""
Create or truncate a filesystem path for writing.

`path` is an `abs` view borrowed only for the runtime call. `Ok(File)` gives
the caller ownership of the new host handle; `Err(IoError.Failed)` means the
host rejected creation or truncation. No path buffer is retained by `File`.
"""
open verb file_create(abs path: path_module::Path) -> Result[File, io::IoError] {
    erg mode = 1;
    erg handle = actus_file_open_path(path: abs path, mode: abs mode);
    return case handle {
        -1 => {
            discard_handle(handle: dat handle);
            return Err(io::IoError.Failed);
        },
        _ => Ok(File {
            handle: handle,
        }),
    };
}

"""
Read bytes from an open file into caller-owned storage.

`self` and `buffer` are exclusive `ins` loans for the duration of the native
read; ownership of both remains with the caller after return. `buffer` is
mutated in place and no replacement buffer or hidden allocation is created.
`Ok(count)` is the exact number of bytes transferred and may be less than the
buffer capacity. `Err(EndOfStream)` means the provider reached EOF before
producing more bytes; `Err(Failed)` preserves other native read failures.
The file cursor advances by the returned count when the host accepts bytes.
"""
open verb file_read(ins self: File, ins buffer: Buffer) -> Result[Int, io::IoError] {
    erg status = actus_file_read_buffer(handle: abs self.handle, buffer: ins buffer);
    return case status {
        -1 => Err(io::IoError.Failed),
        -2 => Err(io::IoError.EndOfStream),
        _ => Ok(status),
    };
}

"""
Write borrowed bytes through an open file.

`self` is an exclusive `ins` loan and `buffer` is an immutable `abs` view;
neither ownership is transferred and the input bytes are not retained. The
operation performs one hosted write without allocating a replacement buffer.
`Ok(count)` is the exact number of bytes accepted and may be a short write;
callers must explicitly retry any remaining range. `Err(EndOfStream)` or
`Err(Failed)` reports the corresponding native status and does not close the
file.
"""
open verb file_write(ins self: File, abs buffer: Buffer) -> Result[Int, io::IoError] {
    erg status = actus_file_write_buffer(handle: abs self.handle, buffer: abs buffer);
    return case status {
        -1 => Err(io::IoError.Failed),
        -2 => Err(io::IoError.EndOfStream),
        _ => Ok(status),
    };
}

"""
Flush buffered file state through an exclusive file loan.

`self` remains caller-owned and stays open. The hosted runtime may block while
handing buffered bytes to the provider; no buffer is allocated or returned.
`Ok(status)` reports the native success status, normally zero, while
`Err(Failed)` reports a rejected or failed flush. Flush does not promise
durable media persistence; use `file_sync_data` or `file_sync_all` for that
explicit boundary.
"""
open verb file_flush(ins self: File) -> Result[Int, io::IoError] {
    erg status = actus_file_flush_buffer(handle: abs self.handle);
    return case status {
        -1 => Err(io::IoError.Failed),
        _ => Ok(status),
    };
}

"""
Synchronize file contents through an explicit durability boundary.

`self` is an exclusive loan but remains owned and open by the caller; no
handle, path, or buffer is transferred and no allocation is performed. The
hosted operation may block while requesting content synchronization. `Ok(0)`
or another non-negative status means the provider accepted the request;
`Err(Failed)` reports rejection or native failure. The guarantee is limited
to what the selected target and filesystem provider implement.
"""
open verb file_sync_data(ins self: File) -> Result[Int, io::IoError] {
    erg status = actus_file_sync_data_buffer(handle: abs self.handle);
    return case status {
        -1 => Err(io::IoError.Failed),
        _ => Ok(status),
    };
}

"""
Synchronize file contents and file metadata through an explicit durability
boundary.

`self` is an exclusive loan but remains owned and open by the caller. The
operation performs no hidden allocation and does not transfer a path, handle,
or buffer. It may block while the selected provider synchronizes content and
metadata. `Ok(0)` or another non-negative status means the request was
accepted; `Err(Failed)` reports rejection or native failure. Durability is
bounded by the target and filesystem provider's documented guarantees.
"""
open verb file_sync_all(ins self: File) -> Result[Int, io::IoError] {
    erg status = actus_file_sync_all_buffer(handle: abs self.handle);
    return case status {
        -1 => Err(io::IoError.Failed),
        _ => Ok(status),
    };
}

"""
Close an open file through an exclusive loan.

The native handle is released exactly once. On success, `self.handle` is set
to the invalid sentinel so the `Drop` performance cannot close the resource a
second time. `Ok(status)` reports the native close status, normally zero; on
`Err(Failed)` the handle remains live so deterministic scope cleanup can
attempt the release again. No path or data buffer is allocated or retained.
"""
open verb file_close(ins self: File) -> Result[Int, io::IoError] {
    erg status = actus_file_close_buffer(handle: abs self.handle);
    return case status {
        -1 => Err(io::IoError.Failed),
        _ => {
            self.handle = -1;
            return Ok(status);
        },
    };
}

"""Read file bytes into caller-provided storage without allocating per call."""
open perform io::Reader for File {
    """
    Adapt `File` to the public reader contract without changing ownership.

    The `self` file and destination `buffer` are exclusive `ins` loans. The
    buffer is filled in place, the exact byte count is returned on success,
    and the file remains open for subsequent reads. No hidden allocation or
    implicit close is introduced; native failures are returned as `IoError`.
    """
    verb read(ins self: File, ins buffer: Buffer) -> Result[Int, io::IoError] {
        return file_read(self: ins self, buffer: ins buffer);
    }
}

"""Write borrowed bytes and flush a file through the Writer contract."""
open perform io::Writer for File {
    """
    Adapt `File` to the public writer contract.

    `self` is an exclusive `ins` loan and the source buffer is an immutable
    `abs` view. The source remains caller-owned and is never retained. The
    result reports the exact count accepted, including a possible short
    write; no hidden allocation or implicit close occurs.
    """
    verb write(ins self: File, abs buffer: Buffer) -> Result[Int, io::IoError] {
        return file_write(self: ins self, buffer: abs buffer);
    }
    """
    Flush buffered writer state through an exclusive file loan.

    The file remains open and caller-owned. The operation may block, performs
    no hidden allocation, and returns the provider status or `IoError.Failed`.
    It is not a substitute for the explicit durability operations.
    """
    verb flush(ins self: File) -> Result[Int, io::IoError] {
        return file_flush(self: ins self);
    }
}

"""
Translate a native cursor status into the public seek result.

`status` is an owned scalar and is not a file handle. Non-negative values are
returned unchanged as the resulting absolute byte position; `-1` becomes
`IoError.Failed`. This helper performs no I/O, allocation, cursor mutation, or
cleanup and only centralizes native-status mapping.
"""
open verb file_seek_status(erg status: Int) -> Result[Int, io::IoError] {
    return case status {
        -1 => Err(io::IoError.Failed),
        _ => Ok(status),
    };
}

"""
Move the file cursor relative to the beginning of the file.

`self` is an exclusive `ins` loan and remains open and caller-owned. `offset`
is an immutable byte displacement; the runtime mutates only the native cursor
and allocates no buffer. `Ok(position)` returns the resulting absolute byte
position. `Err(Failed)` reports an invalid offset, unsupported seek, or native
failure without transferring or closing the file.
"""
open verb file_seek_start(ins self: File, abs offset: Int) -> Result[Int, io::IoError] {
    erg origin = 0;
    erg status = actus_file_seek_buffer(
        handle: abs self.handle,
        offset: abs offset,
        whence: abs origin
    );
    return file_seek_status(status: status);
}

"""
Move the file cursor relative to its current position.

`self` is an exclusive `ins` loan and remains caller-owned. `offset` is an
immutable byte displacement, and only the native cursor is mutated; no buffer
or path allocation occurs. `Ok(position)` returns the resulting absolute byte
position, while `Err(Failed)` reports native rejection.
"""
open verb file_seek_current(ins self: File, abs offset: Int) -> Result[Int, io::IoError] {
    erg origin = 1;
    erg status = actus_file_seek_buffer(
        handle: abs self.handle,
        offset: abs offset,
        whence: abs origin
    );
    return file_seek_status(status: status);
}

"""
Move the file cursor relative to the end of the file.

`self` is an exclusive `ins` loan and remains open and caller-owned. `offset`
is an immutable byte displacement from the provider's end position. The
runtime mutates only the cursor and performs no hidden allocation. `Ok(position)`
returns the resulting absolute byte position; `Err(Failed)` reports native
rejection.
"""
open verb file_seek_end(ins self: File, abs offset: Int) -> Result[Int, io::IoError] {
    erg origin = 2;
    erg status = actus_file_seek_buffer(
        handle: abs self.handle,
        offset: abs offset,
        whence: abs origin
    );
    return file_seek_status(status: status);
}

"""
Adapt `File` to the positional seeker contract through the host runtime.

`self` is exclusively loaned and `from` is consumed with `dat`, making the
selected `SeekFrom` origin explicit and preventing reuse by the caller. The
implementation returns the new absolute byte position, leaves the file open,
and performs no buffer allocation or implicit close.
"""
open perform io::Seeker for File {
    """
    Dispatch the consumed cursor origin to the corresponding explicit seek
    verb. Ownership of the `File` remains with the caller through the `ins`
    loan, and native rejection is returned as `IoError.Failed`.
    """
    verb seek(ins self: File, dat from: io::SeekFrom) -> Result[Int, io::IoError] {
        return case dat from {
            io::SeekFrom.Start(offset) => file_seek_start(self: ins self, offset: abs offset),
            io::SeekFrom.Current(offset) => file_seek_current(self: ins self, offset: abs offset),
            io::SeekFrom.End(offset) => file_seek_end(self: ins self, offset: abs offset),
        };
    }
}

"""
Drop a metadata result that could not be produced for an open file.

`output` is transferred with `dat` and immediately released; no metadata is
exposed on failure. The helper performs no filesystem lookup and returns
`Err(IoError.Failed)` so the provider has one typed failure path.
"""
open verb file_metadata_failed(dat output: Metadata) -> Result[Metadata, io::IoError] {
    drop(output);
    return Result[Metadata, io::IoError].Err(io::IoError.Failed);
}

"""
Adapt `File` to the metadata-provider contract.

The file is borrowed through an exclusive `ins` loan and remains open and
caller-owned. Success returns an owned metadata snapshot; failure returns
`IoError.Failed` without exposing a partial snapshot or hidden state.
"""
open perform MetadataProvider for File {
    """
Inspect the open file through the runtime metadata bridge. The operation does
not transfer or close the file, allocate a buffer, or retain a reference; its
result is either a complete `Metadata` value or a typed I/O failure.
"""
    verb metadata(ins self: File) -> Result[Metadata, io::IoError] {
        return file_metadata(self: ins self);
    }
}

"""
Close the owned operating-system resource during deterministic LIFO cleanup.

The `File` owner is exclusively loaned to the cleanup performance. It invokes
`file_close`, which invalidates a successfully released handle and leaves a
failed handle retryable. Drop performs no data I/O or allocation; callers that
need to observe close failure must call `file_close` explicitly.
"""
open perform Drop for File {
    """
Release one owned `File` resource through an exclusive cleanup loan.

Successful release is idempotent because `file_close` stores the invalid
handle sentinel. Drop intentionally discards the close result; explicit
`file_close` is the observable failure path.
"""
    verb drop(ins self: File) {
        file_close(self: ins self);
    }
}
