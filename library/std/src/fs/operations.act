"""Filesystem operations implemented behind the public `std::fs` facade."""
import {
    io,
    path as path_module,
};

"""
Remove the regular file named by `path`.

`path` is borrowed read-only and is not retained. The bridge returns zero on
success, `-1` on a host failure, and never exposes a raw status to callers.
"""
unsafe extern "C" verb actus_file_remove_path(abs path: path_module::Path) -> Int;

"""
Rename `from` to `to` without copying file contents.

Both path arguments are non-owning `abs` views valid for this call only.
The bridge returns zero on success or `-1` on failure.
"""
unsafe extern "C" verb actus_file_rename_path(
    abs from: path_module::Path,
    abs to: path_module::Path
) -> Int;

"""
Copy the file named by `from` to `to` and return its byte count.

The two path views are borrowed and never retained. A non-negative return is
the number of copied bytes; the C ABI returns `-1` for failure, translated to
`IoError.Failed`.
"""
unsafe extern "C" verb actus_file_copy_path(
    abs from: path_module::Path,
    abs to: path_module::Path
) -> Int;

"""
Resolve `path` through the host filesystem and write the canonical identity
path into `output`. The bridge returns zero only after every component exists
and the destination owns a validated platform path; `-1` reports a missing,
invalid, inaccessible, or unsupported path without replacing the destination.
"""
unsafe extern "C" verb actus_file_canonicalize_path(
    abs path: path_module::Path,
    ins output: path_module::Path
) -> Int;

"""Compare two existing paths by filesystem identity, not lexical spelling."""
unsafe extern "C" verb actus_file_same_path(
    abs left: path_module::Path,
    abs right: path_module::Path
) -> Int;

"""
Create the directory named by `path`.

The path is an `abs` view. The bridge returns zero on success or `-1` when
the host rejects the operation. It does not retain the path or allocate a
converted string; the facade maps `-1` to `IoError.Failed`.
"""
unsafe extern "C" verb actus_file_create_dir_path(abs path: path_module::Path) -> Int;

"""
Remove the empty directory named by `path`.

The path is borrowed for the call. The bridge returns zero on success or
`-1` when the directory is missing, non-empty, or otherwise inaccessible.
"""
unsafe extern "C" verb actus_file_remove_dir_path(abs path: path_module::Path) -> Int;

"""
Read all bytes from `handle` into the caller-owned `ins buffer`.

The runtime appends into the existing allocation and retains no pointer.
The return value is the byte count, `-1` for failure, or `-2` for EOF.
"""
unsafe extern "C" verb actus_file_read_all_buffer(
    abs handle: Int,
    ins buffer: Buffer
) -> Int;

"""
Validate the bytes in `buffer` as UTF-8 without taking ownership.

The buffer is an `abs` view and remains owned by its caller. Zero means
valid UTF-8; the C ABI returns non-zero for invalid data, mapped to
`InvalidData`.
"""
unsafe extern "C" verb actus_buffer_validate_utf8(abs buffer: Buffer) -> Int;

"""Translate the shared file-operation status ABI into a typed result.

`status` is a copied scalar returned by a native bridge. `-1` becomes generic
`IoError.Failed`, `-2` becomes `IoError.EndOfStream`, and non-negative values
remain successful results. This helper performs no I/O and owns no resource.
The legacy bridges using it do not expose a separate permission status.
"""
open verb fs_status(erg status: Int) -> Result[Int, io::IoError] {
    return case status {
        -1 => Err(io::IoError.Failed),
        -2 => Err(io::IoError.EndOfStream),
        _ => Ok(status),
    };
}

"""Remove one regular file at `path`.

`path` is an immutable `abs` view borrowed only during the native call and is
never retained. `Ok(0)` means the host removed the file. Missing, protected,
directory, and otherwise rejected targets are reported as `IoError.Failed` by
this compatibility bridge; no partial deletion is reported as success.
"""
open verb remove_file(abs path: path_module::Path) -> Result[Int, io::IoError] {
    erg status = actus_file_remove_path(path: abs path);
    return fs_status(status: erg status);
}

verb finish_canonicalize(dat output: path_module::Path, erg status: Int) -> Result[path_module::Path, io::IoError] {
    if status == 0 {
        return Ok(output);
    }
    drop(output);
    return Err(io::IoError.Failed);
}

"""Resolve one lexical path to its host filesystem identity.

Unlike `std::path::normalize`, this performs blocking filesystem I/O, follows
symbolic links, requires every component to exist, and returns a newly owned
canonical `Path`. The input is an immutable `abs` view and is never modified
or retained. Partial output is dropped on failure.
"""
open verb canonicalize(abs path: path_module::Path) -> Result[path_module::Path, io::IoError] {
    erg raw: Buffer = Buffer[0];
    append(raw, 46u8);
    append(raw, 0u8);
    erg placeholder = path_module::path_from_ascii(storage: dat raw);
    return case dat placeholder {
        Result.Err(_) => Err(io::IoError.Failed),
        Result.Ok(output) => {
            erg status = actus_file_canonicalize_path(path: abs path, output: ins output);
            return finish_canonicalize(output: dat output, status: erg status);
        },
    };
}

"""Compare two paths by host filesystem identity rather than spelling.

Both arguments are immutable `abs` views, symbolic links are followed, and
both targets must exist. `Ok(true)` means equal identity; `Ok(false)` means
different existing identities. Host lookup failure returns `IoError.Failed`
and missing stable identity returns `IoError.Unsupported`. No path is retained.
"""
open verb same_file(abs left: path_module::Path, abs right: path_module::Path) -> Result[Bool, io::IoError] {
    erg status = actus_file_same_path(left: abs left, right: abs right);
    return case status {
        -2 => Err(io::IoError.Unsupported),
        -1 => Err(io::IoError.Failed),
        0 => Ok(false),
        _ => Ok(true),
    };
}

"""Rename one filesystem path from `from` to `to`.

Both arguments are immutable `abs` views valid only for this call. `Ok(0)` is
returned only after the host completes the rename; rejected, missing,
cross-device, and other failures return `IoError.Failed`. Neither view is
consumed or retained.
"""
open verb rename(abs from: path_module::Path, abs to: path_module::Path) -> Result[Int, io::IoError] {
    erg status = actus_file_rename_path(from: abs from, to: abs to);
    return fs_status(status: erg status);
}

"""Copy one regular file and return the host-reported byte count.

`from` and `to` are immutable `abs` views borrowed for the call. `Ok(count)`
is returned only when the native copy completes; source, destination,
overwrite, and provider failures return `IoError.Failed`. No path view is
consumed or retained and no UTF-8 conversion is performed.
"""
open verb copy_file(abs from: path_module::Path, abs to: path_module::Path) -> Result[Int, io::IoError] {
    erg status = actus_file_copy_path(from: abs from, to: abs to);
    return fs_status(status: erg status);
}

"""Create exactly one directory at `path`.

`path` is an immutable `abs` view borrowed for the native call and is not
retained. `Ok(0)` means the directory was created. Existing, invalid,
parent-missing, protected, and inaccessible targets return `IoError.Failed`;
missing parents are never created implicitly.
"""
open verb create_dir(abs path: path_module::Path) -> Result[Int, io::IoError] {
    erg status = actus_file_create_dir_path(path: abs path);
    return fs_status(status: erg status);
}

"""Remove one empty directory at `path`.

`path` is an immutable `abs` view borrowed for one native call. `Ok(0)` means
the host removed the directory. Missing, non-empty, protected, file-shaped,
and inaccessible targets return `IoError.Failed`; recursive deletion is never
implicit.
"""
open verb remove_dir(abs path: path_module::Path) -> Result[Int, io::IoError] {
    erg status = actus_file_remove_dir_path(path: abs path);
    return fs_status(status: erg status);
}

"""Discard an incomplete owned read buffer before returning a typed failure.

`output` is transferred as `dat` and is always dropped before
`Err(IoError.Failed)` is constructed. The helper performs no I/O, returns no
buffer, and guarantees that a failed read cannot leak partial allocation.
"""
open verb discard_read_output(dat output: Buffer) -> Result[Buffer, io::IoError] {
    drop(output);
    return Result[Buffer, io::IoError].Err(io::IoError.Failed);
}

"""Read one owned open file into a new buffer and close it deterministically.

`file` is transferred as `dat`, so this helper owns the handle and closes it
before returning. `Ok(Buffer)` transfers the complete owned byte buffer;
read or close failure drops that buffer and returns `IoError.Failed`. No file
handle remains live after return, and the caller owns a successful buffer.
"""
open verb read_open_file(dat file: File) -> Result[Buffer, io::IoError] {
    erg output = Buffer[0];
    erg status = actus_file_read_all_buffer(handle: abs file.handle, buffer: ins output);
    erg closed = file_close(self: ins file);
    return case dat closed {
        Result.Err(_) => discard_read_output(output: dat output),
        Result.Ok(_) => case status {
            -1 => discard_read_output(output: dat output),
            _ => Result[Buffer, io::IoError].Ok(dat output),
        },
    };
}

"""
Open `path`, read all bytes, and close the temporary `File` deterministically.

`path` is an `abs` borrow that is not retained. `Ok(Buffer)` transfers a new
owned result buffer to the caller; `Err(IoError.Failed)` or
`Err(IoError.EndOfStream)` reports the runtime result after the file is
closed. The caller owns the returned buffer and must eventually drop it.
"""
open verb read_to_bytes(abs path: path_module::Path) -> Result[Buffer, io::IoError] {
    erg opened = file_open(path: abs path);
    return case dat opened {
        Result.Ok(value) => read_open_file(file: dat value),
        Result.Err(error) => propagate_text_error(error: dat error),
    };
}

"""Drop invalid text storage before returning `IoError.InvalidData`.

`output` is transferred as `dat` and is always dropped before the error result
is constructed. The helper performs no I/O and never returns partial text.
"""
open verb reject_invalid_text(dat output: Buffer) -> Result[Buffer, io::IoError] {
    drop(output);
    return Err(io::IoError.InvalidData);
}

"""
Validate text while consuming the temporary `dat` byte buffer. `Ok(output)`
returns the same owned buffer; invalid data returns `Err(IoError.InvalidData)`
after ownership cleanup remains deterministic.
"""
open verb accept_valid_text(dat output: Buffer) -> Result[Buffer, io::IoError] {
    return Ok(output);
}

"""Propagate one I/O error through a buffer-returning operation.

`error` is transferred as `dat` and consumed exhaustively. The exact variant,
including `PermissionDenied`, is rebuilt in `Err`; no allocation, I/O, or
ownership is retained by this adapter.
"""
open verb propagate_text_error(dat error: io::IoError) -> Result[Buffer, io::IoError] {
    return case dat error {
        io::IoError.EndOfStream => Result[Buffer, io::IoError].Err(io::IoError.EndOfStream),
        io::IoError.Failed => Result[Buffer, io::IoError].Err(io::IoError.Failed),
        io::IoError.InvalidInput => Result[Buffer, io::IoError].Err(io::IoError.InvalidInput),
        io::IoError.InvalidData => Result[Buffer, io::IoError].Err(io::IoError.InvalidData),
        io::IoError.Unsupported => Result[Buffer, io::IoError].Err(io::IoError.Unsupported),
        io::IoError.PermissionDenied => Result[Buffer, io::IoError].Err(io::IoError.PermissionDenied),
        io::IoError.Busy => Result[Buffer, io::IoError].Err(io::IoError.Busy),
    };
}

"""Validate one owned byte buffer as UTF-8 and preserve its result.

`output` is transferred as `dat` and inspected for validation. Valid bytes
return as the same owned `Buffer`; invalid bytes are dropped and return
`IoError.InvalidData`. No filesystem I/O occurs and partial text escapes never.
"""
open verb validate_text_bytes(dat output: Buffer) -> Result[Buffer, io::IoError] {
    erg valid = actus_buffer_validate_utf8(buffer: abs output);
    return case valid {
        0 => accept_valid_text(output: dat output),
        _ => reject_invalid_text(output: dat output),
    };
}

"""Map a completed byte read into validated text bytes or a typed error.

`loaded` is transferred as `dat`. Reader failures preserve their exact
`IoError` variant; successful bytes are transferred to UTF-8 validation, which
drops invalid data. No intermediate buffer is duplicated or retained.
"""
open verb validate_loaded_text(dat loaded: Result[Buffer, io::IoError]) -> Result[Buffer, io::IoError] {
    return case dat loaded {
        Result.Err(error) => propagate_text_error(error: dat error),
        Result.Ok(output) => validate_text_bytes(output: dat output),
    };
}

"""Read a file and validate its bytes as UTF-8.

`path` is an immutable `abs` borrow used only while opening the file. On
success, `Ok(Buffer)` transfers ownership of the validated bytes. Open/read
failures preserve their typed `IoError`; invalid UTF-8 returns
`IoError.InvalidData` after all temporary file and buffer ownership is cleaned
up. The operation performs blocking file I/O and never returns partial text.
"""
open verb read_to_string(abs path: path_module::Path) -> Result[Buffer, io::IoError] {
    erg loaded = read_to_bytes(path: abs path);
    return validate_loaded_text(loaded: dat loaded);
}
