"""Basic filesystem facts returned without exposing host-specific handles.

`size` is the logical byte length. Timestamps are signed Unix seconds and
carry an explicit status because hosts may not provide every timestamp. The
identity pair is opaque portable data: POSIX uses device/inode and Windows
uses volume/file index. The value contains only copied facts and no host
handle.
"""
import {
    io,
    path as path_module,
};

"""The metadata value was read successfully and its scalar is valid."""
open const METADATA_VALUE_AVAILABLE: Int = 0;
"""The host does not expose the requested metadata value."""
open const METADATA_VALUE_UNSUPPORTED: Int = 1;
"""The host exposed the field but its value cannot be represented here."""
open const METADATA_VALUE_UNAVAILABLE: Int = 2;
"""No portable platform identity is present in the metadata snapshot."""
open const METADATA_IDENTITY_NONE: Int = 0;
"""The identity pair contains POSIX device and inode values."""
open const METADATA_IDENTITY_POSIX: Int = 1;
"""The identity pair contains Windows volume and file-index values."""
open const METADATA_IDENTITY_WINDOWS: Int = 2;

"""Typed causes for a metadata request that did not produce a snapshot."""
open enum MetadataError {
    """The requested path does not exist or was removed during inspection."""
    NotFound,
    """The provider denied metadata inspection for the requested path."""
    PermissionDenied,
    """The selected provider cannot perform this metadata operation."""
    Unsupported,
    """The provider rejected the request without a more specific cause."""
    Failed,
}

"""
An owned scalar metadata record returned by filesystem inspection.
Its erg fields are copied facts and require no host-handle cleanup.
"""
open struct Metadata {
    """Logical file length in bytes, not including any host metadata header."""
    erg size: Int,
    """One when the path identifies a regular file, otherwise zero."""
    erg is_file: Int,
    """One when the path identifies a directory, otherwise zero."""
    erg is_dir: Int,
    """One when the host marks the file read-only, otherwise zero."""
    erg readonly: Int,
    """One when the path itself is a symbolic link, otherwise zero."""
    erg is_symlink: Int,
    """Signed Unix seconds for modification time when modified_status is available."""
    erg modified_seconds: i64,
    """Status of modified_seconds: available, unsupported, or unavailable."""
    erg modified_status: Int,
    """Signed Unix seconds for access time when accessed_status is available."""
    erg accessed_seconds: i64,
    """Status of accessed_seconds: available, unsupported, or unavailable."""
    erg accessed_status: Int,
    """Signed Unix seconds for creation time when created_status is available."""
    erg created_seconds: i64,
    """Status of created_seconds: available, unsupported, or unavailable."""
    erg created_status: Int,
    """First opaque platform identity component."""
    erg identity_primary: u64,
    """Second opaque platform identity component."""
    erg identity_secondary: u64,
    """Identity layout discriminator: none, POSIX, or Windows."""
    erg identity_kind: Int,
    """Status of the platform identity pair."""
    erg identity_status: Int,
}

"""
Construct the empty metadata token used when a publication destination is
expected to be absent.

The returned identity kind is `METADATA_IDENTITY_NONE`; it is not a claim
that any path currently exists. Callers may pass this token to a coordinated
publication operation to require an absent destination. All scalar facts are
marked unavailable or zero and no filesystem access occurs.
"""
open verb metadata_absent() -> Metadata {
    erg modified_status: Int = METADATA_VALUE_UNAVAILABLE;
    erg accessed_status: Int = METADATA_VALUE_UNAVAILABLE;
    erg created_status: Int = METADATA_VALUE_UNAVAILABLE;
    erg identity_status: Int = METADATA_VALUE_UNAVAILABLE;
    erg identity_kind: Int = METADATA_IDENTITY_NONE;
    return Metadata {
        size: 0,
        is_file: 0,
        is_dir: 0,
        readonly: 0,
        is_symlink: 0,
        modified_seconds: 0i64,
        modified_status: modified_status,
        accessed_seconds: 0i64,
        accessed_status: accessed_status,
        created_seconds: 0i64,
        created_status: created_status,
        identity_primary: 0u64,
        identity_secondary: 0u64,
        identity_kind: identity_kind,
        identity_status: identity_status,
    };
}

verb metadata_default() -> Metadata {
    return metadata_absent();
}

"""
Fill `output` with metadata for `path` without retaining either buffer.

`path` is an `abs` byte view. `output` is an `ins` destination owned by the
caller. The bridge returns zero on success and `-1` when the host cannot
inspect the path; the public wrapper translates that status to `IoError`.
"""
unsafe extern "C" verb actus_file_metadata_path(
    abs path: path_module::Path,
    ins output: Metadata
) -> Int;

"""
Fill `output` with metadata for `path` without following a symbolic link.

The path view and output ownership rules match `actus_file_metadata_path`.
The bridge returns zero on success and `-1` when the host cannot inspect the
path itself.
"""
unsafe extern "C" verb actus_file_symlink_metadata_path(
    abs path: path_module::Path,
    ins output: Metadata
) -> Int;

"""
Native metadata status values used by the detailed metadata operations.

Zero is success; `-2` means not found, `-3` permission denied, `-4`
unsupported, and `-1` an unspecified provider failure. The output slot is
initialized only on success.
"""
verb metadata_detailed_failed(dat output: Metadata, erg status: Int) -> Result[Metadata, MetadataError] {
    drop(output);
    return case status {
        -2 => Err(MetadataError.NotFound),
        -3 => Err(MetadataError.PermissionDenied),
        -4 => Err(MetadataError.Unsupported),
        _ => Err(MetadataError.Failed),
    };
}

"""
Fill `output` from the open handle identified by `handle`.

The handle is an opaque scalar owned by the `File` value and is not closed
or transferred by this call. `output` is exclusively borrowed for the call.
The bridge returns zero on success or `-1` on a host metadata failure.
"""
unsafe extern "C" verb actus_file_metadata_handle_buffer(
    abs handle: Int,
    ins output: Metadata
) -> Int;

"""
The metadata provider contract for open filesystem resources.

The path-level `metadata` verb below remains the canonical free operation;
open handles satisfy this same operation through static performance dispatch.
"""
open role MetadataProvider {
    """Inspect an ins file handle and return metadata facts or typed failure."""
    verb metadata(ins self: File) -> Result[Metadata, io::IoError];
}

"""Drop an incomplete metadata value before returning `IoError.Failed`."""
open verb metadata_failed(dat output: Metadata) -> Result[Metadata, io::IoError] {
    drop(output);
    return Result[Metadata, io::IoError].Err(io::IoError.Failed);
}

"""
Inspect one filesystem path without transferring path ownership.

`path` is an `abs` view borrowed for the runtime bridge and never retained.
`Ok(Metadata)` contains the copied scalar facts; `Err(IoError.Failed)` means
the host could not inspect the path. The operation performs no path-string
conversion and does not allocate an owned path representation.
"""
open verb metadata(abs path: path_module::Path) -> Result[Metadata, io::IoError] {
    erg output = metadata_default();
    erg status = actus_file_metadata_path(path: abs path, output: ins output);
    return case status {
        -1 => metadata_failed(output: dat output),
        -2 => metadata_failed(output: dat output),
        -3 => metadata_failed(output: dat output),
        -4 => metadata_failed(output: dat output),
        _ => Result[Metadata, io::IoError].Ok(output),
    };
}

"""
Inspect one path and preserve the provider's metadata failure cause.

`path` is borrowed through `abs`; `Ok(Metadata)` owns only copied scalar
facts. `Err(MetadataError)` distinguishes not found, permission denied,
unsupported, and generic provider failure. No path, handle, or allocation is
retained after the operation.
"""
open verb metadata_detailed(abs path: path_module::Path) -> Result[Metadata, MetadataError] {
    erg output = metadata_default();
    erg status = actus_file_metadata_path(path: abs path, output: ins output);
    return case status {
        0 => Ok(output),
        _ => metadata_detailed_failed(output: dat output, status: status),
    };
}

"""
Inspect an open file through an exclusively loaned handle.

The returned metadata owns only copied scalar facts. The file handle remains
owned by the caller, and a failed native status becomes `Err(Failed)`.
"""
open verb file_metadata(ins self: File) -> Result[Metadata, io::IoError] {
    erg output = metadata_default();
    erg status = actus_file_metadata_handle_buffer(handle: abs self.handle, output: ins output);
    return case status {
        -1 => metadata_failed(output: dat output),
        _ => Result[Metadata, io::IoError].Ok(output),
    };
}

"""
Inspect one path without following a symbolic link.

`Ok(Metadata)` contains copied scalar facts, including whether the path
itself is a symbolic link. The operation never creates, follows, or retains a
link target.
"""
open verb symlink_metadata(abs path: path_module::Path) -> Result[Metadata, io::IoError] {
    erg output = metadata_default();
    erg status = actus_file_symlink_metadata_path(path: abs path, output: ins output);
    return case status {
        -1 => metadata_failed(output: dat output),
        -2 => metadata_failed(output: dat output),
        -3 => metadata_failed(output: dat output),
        -4 => metadata_failed(output: dat output),
        _ => Result[Metadata, io::IoError].Ok(output),
    };
}

"""
Inspect one path without following a symbolic link and preserve failure cause.

The `abs` path remains owned by the caller. Success returns copied metadata;
failure distinguishes not found, permission denied, unsupported, and generic
provider rejection. The operation performs no hidden link traversal or
resource retention.
"""
open verb symlink_metadata_detailed(abs path: path_module::Path) -> Result[Metadata, MetadataError] {
    erg output = metadata_default();
    erg status = actus_file_symlink_metadata_path(path: abs path, output: ins output);
    return case status {
        0 => Ok(output),
        _ => metadata_detailed_failed(output: dat output, status: status),
    };
}
