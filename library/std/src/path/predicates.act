"""Runtime-backed path predicates and component-aware comparisons."""

"""Inspect absolute-root state without consuming or allocating the path."""
unsafe extern "C" verb actus_path_is_absolute(abs self: Path) -> Bool;

"""Inspect relative-root state through the C ABI and return a Boolean without consuming or allocating the path."""
unsafe extern "C" verb actus_path_is_relative(abs self: Path) -> Bool;

"""Inspect through the C ABI whether the path has any platform root and return a Boolean without allocation."""
unsafe extern "C" verb actus_path_has_root(abs self: Path) -> Bool;

"""Compare complete borrowed path components at the Rust ABI boundary."""
unsafe extern "C" verb actus_path_starts_with(abs self: Path, abs prefix: Path) -> Bool;

"""Compare complete trailing borrowed components at the Rust ABI boundary."""
unsafe extern "C" verb actus_path_ends_with(abs self: Path, abs suffix: Path) -> Bool;

"""
Return `true` when borrowed `abs self` has an absolute platform root.
Inspection reads raw path units and performs no allocation or mutation.
"""
open verb is_absolute(abs self: Path) -> Bool {
    return actus_path_is_absolute(self: abs self);
}

"""
Return `true` when borrowed `abs self` is relative on its selected platform.
The predicate is read-only and allocation-free.
"""
open verb is_relative(abs self: Path) -> Bool {
    return actus_path_is_relative(self: abs self);
}

"""
Return `true` when borrowed `abs self` has any platform root. Raw units are
inspected without allocation or mutation.
"""
open verb has_root(abs self: Path) -> Bool {
    return actus_path_has_root(self: abs self);
}

"""
Return `true` when borrowed `abs prefix` matches complete leading components
of borrowed `abs self`. Comparison is component-aware and allocation-free.
"""
open verb starts_with(abs self: Path, abs prefix: Path) -> Bool {
    return actus_path_starts_with(self: abs self, prefix: abs prefix);
}

"""
Return `true` when borrowed `abs suffix` matches complete trailing components
of borrowed `abs self`. Comparison is component-aware and allocation-free.
"""
open verb ends_with(abs self: Path, abs suffix: Path) -> Bool {
    return actus_path_ends_with(self: abs self, suffix: abs suffix);
}
